+    float q;
+} pel_gate_curve[(PEL_GRAIN_GATES - 1) * PEL_GRAIN_CURVE_ROWS] = {
+    {0.0029f, 0.3009f}, {0.0083f, 0.2987f}, {0.0252f, 0.2932f}, {0.0487f, 0.2920f},
