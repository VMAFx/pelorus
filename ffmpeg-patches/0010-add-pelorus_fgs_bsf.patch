+/**
+ * @file
+ * Pelorus film-grain-synthesis (FGS) bitstream filter, H.274 / HEVC leg.
+ *
+ * Inserts an ITU-T H.274 Film Grain Characteristics (FGC) SEI message (HEVC
+ * payload type 19, SEI_TYPE_FILM_GRAIN_CHARACTERISTICS) as a PREFIX NAL into
+ * each HEVC access unit, so a conforming decoder re-synthesizes film grain that
+ * was removed before encode (e.g. by vf_pelorus_denoise_vulkan). It completes
+ * the HEVC/H.274 leg of the round-trip that vf_pelorus_grain_estimate_vulkan
+ * (ADR-0115) started: the estimator measures grain on the GPU and emits the
+ * Pelorus PEL_SEC_FILMGRAIN section + the H.274 mode scalars; the AV1 leg
+ * already round-trips through the native AV_FRAME_DATA_FILM_GRAIN_PARAMS channel
+ * that AV1 encoders consume. There is NO equivalent automatic path for HEVC —
+ * stock FFmpeg encoders do not propagate film-grain frame side data into the
+ * HEVC bitstream — so this BSF carries the parameters into the elementary stream
+ * itself. See docs/usage/grain-fgs-bsf.md and ADR-0117.
+ *
+ * SCOPE / honesty: this BSF inserts a STATIC FGC model that the user supplies
+ * via AVOptions (the canonical FFmpeg metadata-BSF contract — hevc_metadata,
+ * h264_metadata, av1_metadata all set static parameters this way). A BSF
+ * operates on AVPackets, and no stock encoder forwards the estimator's per-frame
+ * film-grain frame side data onto the coded packet, so per-frame estimate ->
+ * SEI plumbing through an arbitrary HEVC encoder is not expressible in the
+ * pinned stock FFmpeg baseline;
+ * the static-model path is the honest, fully general one. The defaults follow
+ * the SMPTE RDD 5 profile that FFmpeg's H.274 synthesizer (libavcodec/h274.c)
+ * implements: model 0 (frequency filtering), additive blending, a
+ * log2_scale_factor in [2,7] and explicit cutoff frequencies (ADR-0155). The
+ * estimator's per-band RMS maps onto scale_y; docs/usage/grain-fgs-bsf.md gives
+ * the derivation recipe.
+ *
+ * Built on the coded-bitstream (CBS) generic BSF framework (cbs_bsf.c), exactly
+ * like hevc_metadata: each access unit is parsed into a CodedBitstreamFragment,
+ * we add one FGC SEI message via ff_cbs_sei_add_message(), and CBS reassembles
+ * the AU. Opt-in and no-op by construction: the filter does nothing unless the
+ * comp_model_present mask selects at least one colour component.
+ */
+
+#include <string.h>
+
+#include "libavutil/common.h"
+#include "libavutil/opt.h"
+#include "libavutil/pixdesc.h"
+
+/* FFmpeg 9 requires fully-qualified includes from libavcodec/bsf/: the
+ * relative form ("bsf.h") no longer resolves from that subdirectory. */
+#include "libavcodec/bsf.h"
+#include "libavcodec/bsf_internal.h"
+#include "libavcodec/cbs.h"
+#include "libavcodec/cbs_bsf.h"
+#include "libavcodec/cbs_h265.h"
+#include "libavcodec/cbs_sei.h"
+#include "libavcodec/sei.h"
+
+#include "libavcodec/hevc/hevc.h"
+
+/* Comp-model component bitmask for the `components` option. */
+#define PEL_FGS_COMP_Y (1 << 0)
+#define PEL_FGS_COMP_CB (1 << 1)
+#define PEL_FGS_COMP_CR (1 << 2)
+
+/* H.274 film_grain_model_id values. */
+#define PEL_FGS_MODEL_FREQ 0 /* frequency filtering (SMPTE RDD 5 profile) */
+#define PEL_FGS_MODEL_AR 1   /* auto-regression                           */
+
+/* SMPTE RDD 5-2006 subclause 1.4, the profile libavcodec/h274.c implements:
+ * log2_scale_factor in [2,7]. */
+#define PEL_FGS_RDD5_LOG2_MIN 2
+#define PEL_FGS_RDD5_LOG2_MAX 7
+
+typedef struct PelorusFGSContext {
+    CBSBSFContext common;
+
+    /* H.274 FGC model parameters (the static model inserted into every AU). */
+    int model_id;      /* 0 = frequency filtering, 1 = auto-regression       */
+    int blending_mode; /* 0 = additive, 1 = multiplicative                   */
+    int log2_scale;    /* H.274 log2_scale_factor, [0,15]                    */
+    int components;    /* bitmask: which colour components carry a model     */
+    int persistence;   /* film_grain_characteristics_persistence_flag        */
+
+    /* One intensity interval per component: luma uses [intensity_low,
+     * intensity_high]; Cb and Cr use [intensity_low_c, intensity_high_c],
+     * because the chroma interval is matched against the chroma block average,
+     * not luma. v0.x emits one interval per component; a follow-up maps the
+     * estimator's 8 bands onto multiple intervals. */
+    int intensity_low;    /* intensity_interval_lower_bound[0][0], [0,255]   */
+    int intensity_high;   /* intensity_interval_upper_bound[0][0], [0,255]   */
+    int intensity_low_c;  /* intensity_interval_lower_bound[1,2][0], [0,255] */
+    int intensity_high_c; /* intensity_interval_upper_bound[1,2][0], [0,255] */
+    int scale_y;          /* comp_model_value[0][0][0] (grain sigma)         */
+    int scale_c;          /* comp_model_value[1,2][0][0] when Cb/Cr selected */
+    /* Model 0 only: comp_model_value[c][0][1] and [c][0][2], the horizontal and
+     * vertical high cutoff frequencies of the 16x16 DCT band-pass. */
+    int cutoff_h;
+    int cutoff_v;
+
+    /* When set, do not insert a fresh SEI if the AU already carries an FGC SEI
+     * (avoid double-stamping a stream a previous stage already marked). */
+    int skip_existing;
+
+    H265RawFilmGrainCharacteristics fgc;
+    int warned_no_components;
+    int logged_range_error;
+    int logged_drop;
+
+    /* Colour description cached from the active SPS. When the FGC SEI omits its
+     * own colour description (separate_colour_description_present_flag = 0), the
+     * H.265 syntax INFERS these six fields from the active SPS, and the CBS
+     * writer verifies the payload already holds the inferred value. We cache
+     * them from the most recent SPS in the stream so the inferred-value check
+     * passes on inter AUs (which carry no SPS of their own). */
+    int have_colour_desc;
+    uint8_t cd_bit_depth_luma_minus8;
+    uint8_t cd_bit_depth_chroma_minus8;
+    uint8_t cd_full_range_flag;
+    uint8_t cd_colour_primaries;
+    uint8_t cd_transfer_characteristics;
+    uint8_t cd_matrix_coeffs;
+    int warned_no_sps;
+} PelorusFGSContext;
+
+static int pel_fgs_component_present(const PelorusFGSContext *ctx, int c)
+{
+    static const int mask[3] = {PEL_FGS_COMP_Y, PEL_FGS_COMP_CB, PEL_FGS_COMP_CR};
+    return !!(ctx->components & mask[c]);
+}
+
+/* Fill one colour component's model. Model 0 carries the sigma plus both high
+ * cutoff frequencies explicitly (num_model_values_minus1 = 2): H.274 infers
+ * absent cutoffs as 8, but libavcodec/h274.c reads them as zero and clamps to
+ * its coarsest pattern, and SMPTE RDD 5 allows at most three values. Model 1
+ * carries the sigma only; H.274 infers the absent auto-regression
+ * correlations as zero (white grain). */
+static void pel_fgs_fill_component(PelorusFGSContext *ctx, int c)
+{
+    H265RawFilmGrainCharacteristics *fgc = &ctx->fgc;
+    const int luma = (c == 0);
+
+    fgc->comp_model_present_flag[c] = 1;
+    fgc->num_intensity_intervals_minus1[c] = 0;
+    fgc->intensity_interval_lower_bound[c][0] =
+        (uint8_t)(luma ? ctx->intensity_low : ctx->intensity_low_c);
+    fgc->intensity_interval_upper_bound[c][0] =
+        (uint8_t)(luma ? ctx->intensity_high : ctx->intensity_high_c);
+    fgc->comp_model_value[c][0][0] = (int16_t)(luma ? ctx->scale_y : ctx->scale_c);
+    if (ctx->model_id == PEL_FGS_MODEL_FREQ) {
+        fgc->num_model_values_minus1[c] = 2;
+        fgc->comp_model_value[c][0][1] = (int16_t)ctx->cutoff_h;
+        fgc->comp_model_value[c][0][2] = (int16_t)ctx->cutoff_v;
+    } else {
+        fgc->num_model_values_minus1[c] = 0;
+    }
+}
+
+/* Fill the H.274 FGC raw payload from the configured static model. The colour
+ * description is inferred from the active SPS (separate_colour_description = 0),
+ * matching how an encoder-side estimate would be described relative to the
+ * stream. The comp_model_value range was validated against the stream's bit
+ * depth before this runs (pel_fgs_check_scales). */
+static void pel_fgs_fill(PelorusFGSContext *ctx)
+{
+    H265RawFilmGrainCharacteristics *fgc = &ctx->fgc;
+    int c;
+
+    memset(fgc, 0, sizeof(*fgc));
+
+    fgc->film_grain_characteristics_cancel_flag = 0;
+    fgc->film_grain_model_id = ctx->model_id;
+    /* The FGC SEI omits its own colour description and INFERS it from the active
+     * SPS. The CBS writer verifies the payload already carries the inferred
+     * value, so pre-fill the cached SPS colour description (see the cache in
+     * pel_fgs_update_fragment). */
+    fgc->separate_colour_description_present_flag = 0;
+    fgc->film_grain_bit_depth_luma_minus8 = ctx->cd_bit_depth_luma_minus8;
+    fgc->film_grain_bit_depth_chroma_minus8 = ctx->cd_bit_depth_chroma_minus8;
+    fgc->film_grain_full_range_flag = ctx->cd_full_range_flag;
+    fgc->film_grain_colour_primaries = ctx->cd_colour_primaries;
+    fgc->film_grain_transfer_characteristics = ctx->cd_transfer_characteristics;
+    fgc->film_grain_matrix_coeffs = ctx->cd_matrix_coeffs;
+    fgc->blending_mode_id = ctx->blending_mode;
+    fgc->log2_scale_factor = ctx->log2_scale;
+
+    for (c = 0; c < 3; c++) {
+        if (pel_fgs_component_present(ctx, c))
+            pel_fgs_fill_component(ctx, c);
+    }
+
+    fgc->film_grain_characteristics_persistence_flag = ctx->persistence;
+}
+
+/* Largest legal comp_model_value for one component: [0, 2^bd - 1] for model 0
+ * and [-2^(bd-1), 2^(bd-1) - 1] for model 1 (Rec. ITU-T H.274 (01/2026),
+ * fg_comp_model_value semantics; the same bounds as the ses() call in
+ * libavcodec/cbs_h265_syntax_template.c). Every option is non-negative, so the
+ * lower bound never binds. */
+static int pel_fgs_model_value_max(int model_id, int bit_depth)
+{
+    if (model_id == PEL_FGS_MODEL_FREQ)
+        return (1 << bit_depth) - 1;
+    return (1 << (bit_depth - 1)) - 1;
+}
+
+/* Reject a sigma the CBS writer would refuse at this bit depth. Without this
+ * check every access unit fails to serialize, so the BSF drops every packet and
+ * the ffmpeg CLI still exits 0 with an empty output. */
+static int pel_fgs_check_scales(AVBSFContext *bsf, int bd_luma, int bd_chroma, const char *source,
+                                int log_level)
+{
+    const PelorusFGSContext *ctx = bsf->priv_data;
+    int c;
+
+    for (c = 0; c < 3; c++) {
+        const int bd = c ? bd_chroma : bd_luma;
+        const int value = c ? ctx->scale_c : ctx->scale_y;
+        const int max = pel_fgs_model_value_max(ctx->model_id, bd);
+
+        if (!pel_fgs_component_present(ctx, c) || value <= max)
+            continue;
+        av_log(bsf, log_level,
+               "pelorus_fgs: %s=%d exceeds the H.274 comp_model_value maximum %d for "
+               "model_id=%d at %d-bit %s (bit depth %s).\n",
+               c ? "scale_c" : "scale_y", value, max, ctx->model_id, bd, c ? "chroma" : "luma",
+               source);
+        return AVERROR(EINVAL);
+    }
+    return 0;
+}
+
+/* Re-validate against the bit depth of the active SPS on every access unit (and
+ * on the extradata during init, which fails init). The detailed error is
+ * logged once; later failures are logged at debug level. */
+static int pel_fgs_check_stream(AVBSFContext *bsf)
+{
+    PelorusFGSContext *ctx = bsf->priv_data;
+    int err;
+
+    if (!ctx->have_colour_desc)
+        return 0;
+    err = pel_fgs_check_scales(bsf, ctx->cd_bit_depth_luma_minus8 + 8,
+                               ctx->cd_bit_depth_chroma_minus8 + 8, "from the active SPS",
+                               ctx->logged_range_error ? AV_LOG_DEBUG : AV_LOG_ERROR);
+    if (err < 0)
+        ctx->logged_range_error = 1;
+    return err;
+}
+
+/* Cache the colour description from any SPS present in this access unit, so the
+ * inferred-value check in the FGC SEI writer passes on subsequent inter AUs
+ * (which carry no SPS). Mirrors the H.265 VUI inference defaults: an absent
+ * colour description infers primaries/transfer/matrix = 2 (unspecified), and an
+ * absent video-signal-type infers full_range = 0. */
+static void pel_fgs_cache_colour_desc(PelorusFGSContext *ctx, const CodedBitstreamFragment *au)
+{
+    int i;
+    for (i = 0; i < au->nb_units; i++) {
+        if (au->units[i].type == HEVC_NAL_SPS && au->units[i].content) {
+            const H265RawSPS *sps = au->units[i].content;
+            ctx->cd_bit_depth_luma_minus8 = sps->bit_depth_luma_minus8;
+            ctx->cd_bit_depth_chroma_minus8 = sps->bit_depth_chroma_minus8;
+            ctx->cd_full_range_flag =
+                sps->vui.video_signal_type_present_flag ? sps->vui.video_full_range_flag : 0;
+            ctx->cd_colour_primaries =
+                sps->vui.colour_description_present_flag ? sps->vui.colour_primaries : 2;
+            ctx->cd_transfer_characteristics =
+                sps->vui.colour_description_present_flag ? sps->vui.transfer_characteristics : 2;
+            ctx->cd_matrix_coeffs =
+                sps->vui.colour_description_present_flag ? sps->vui.matrix_coefficients : 2;
+            ctx->have_colour_desc = 1;
+        }
+    }
+}
+
+static int pel_fgs_update_fragment(AVBSFContext *bsf, AVPacket *pkt, CodedBitstreamFragment *au)
+{
+    PelorusFGSContext *ctx = bsf->priv_data;
+    SEIRawMessage *existing = NULL;
+    int err;
+
+    /* No-op when no component carries a model: a pure pass-through BSF. */
+    if (!ctx->components) {
+        if (!ctx->warned_no_components) {
+            ctx->warned_no_components = 1;
+            av_log(bsf, AV_LOG_WARNING,
+                   "pelorus_fgs: no components selected; passing through "
+                   "without inserting an FGC SEI.\n");
+        }
+        return 0;
+    }
+
+    /* Track the active SPS colour description (the FGC SEI's inferred colour
+     * fields) across extradata and picture fragments, and refuse a model its
+     * bit depth cannot carry. Extradata (pkt == NULL) carries no picture; only
+     * coded access units get the SEI. */
+    pel_fgs_cache_colour_desc(ctx, au);
+    err = pel_fgs_check_stream(bsf);
+    if (err < 0 || !pkt)
+        return err;
+
+    /* Cannot write a colour-description-omitting FGC SEI before the first SPS
+     * is seen; pass the AU through until one establishes the inferred values. */
+    if (!ctx->have_colour_desc) {
+        if (!ctx->warned_no_sps) {
+            ctx->warned_no_sps = 1;
+            av_log(bsf, AV_LOG_WARNING,
+                   "pelorus_fgs: no SPS seen yet; passing access unit through "
+                   "until the colour description is known.\n");
+        }
+        return 0;
+    }
+
+    if (ctx->skip_existing) {
+        err = ff_cbs_sei_find_message(ctx->common.output, au, SEI_TYPE_FILM_GRAIN_CHARACTERISTICS,
+                                      &existing);
+        if (err == 0 && existing)
+            return 0; /* already marked; leave the stream untouched */
+    }
+
+    pel_fgs_fill(ctx);
+
+    err = ff_cbs_sei_add_message(ctx->common.output, au, 1 /* prefix */,
+                                 SEI_TYPE_FILM_GRAIN_CHARACTERISTICS, &ctx->fgc, NULL);
+    if (err < 0) {
+        av_log(bsf, AV_LOG_ERROR, "pelorus_fgs: failed to add Film Grain Characteristics SEI.\n");
+        return err;
+    }
+
+    return 0;
+}
+
+static const CBSBSFType pel_fgs_type = {
+    .codec_id = AV_CODEC_ID_HEVC,
+    .fragment_name = "access unit",
+    .unit_name = "NAL unit",
+    .update_fragment = &pel_fgs_update_fragment,
+};
+
+/* Warn about valid H.274 parameters outside the SMPTE RDD 5 profile, the only
+ * profile FFmpeg's synthesizer implements (libavcodec/h274.h
+ * ff_h274_film_grain_params_supported, libavcodec/h274.c). */
+static void pel_fgs_warn_profile(AVBSFContext *bsf)
+{
+    const PelorusFGSContext *ctx = bsf->priv_data;
+
+    if (ctx->model_id != PEL_FGS_MODEL_FREQ)
+        av_log(bsf, AV_LOG_WARNING,
+               "pelorus_fgs: model_id=%d is valid H.274 but outside SMPTE RDD 5; FFmpeg's "
+               "H.274 synthesizer implements model 0 only, so its HEVC decoder ignores "
+               "this SEI and outputs no grain.\n",
+               ctx->model_id);
+    if (ctx->blending_mode != 0)
+        av_log(bsf, AV_LOG_WARNING,
+               "pelorus_fgs: blending_mode=%d is outside SMPTE RDD 5 (additive only); "
+               "FFmpeg's synthesizer blends additively regardless.\n",
+               ctx->blending_mode);
+    if (ctx->log2_scale < PEL_FGS_RDD5_LOG2_MIN || ctx->log2_scale > PEL_FGS_RDD5_LOG2_MAX)
+        av_log(bsf, AV_LOG_WARNING,
+               "pelorus_fgs: log2_scale=%d is outside the SMPTE RDD 5 range [%d,%d]; each "
+               "step above it halves the synthesized grain amplitude.\n",
+               ctx->log2_scale, PEL_FGS_RDD5_LOG2_MIN, PEL_FGS_RDD5_LOG2_MAX);
+}
+
+/* Bit depth of the stream as far as the codec parameters know it (an encoder's
+ * pixel format, or a demuxer's probed one). Returns 0 when unknown; the active
+ * SPS is then checked per access unit instead. */
+static int pel_fgs_par_bit_depth(const AVCodecParameters *par, int *bd_luma, int *bd_chroma)
+{
+    const AVPixFmtDescriptor *desc = av_pix_fmt_desc_get((enum AVPixelFormat)par->format);
+
+    if (desc && desc->nb_components > 0) {
+        *bd_luma = desc->comp[0].depth;
+        *bd_chroma = desc->nb_components > 2 ? desc->comp[1].depth : desc->comp[0].depth;
+    } else if (par->bits_per_raw_sample > 0) {
+        *bd_luma = par->bits_per_raw_sample;
+        *bd_chroma = par->bits_per_raw_sample;
+    } else {
+        return 0;
+    }
+    return *bd_luma >= 8 && *bd_luma <= 16 && *bd_chroma >= 8 && *bd_chroma <= 16;
+}
+
+/* Reject every option combination that cannot produce a working FGC SEI before
+ * the first packet, so the ffmpeg CLI fails with a non-zero exit instead of
+ * dropping every packet. */
+static int pel_fgs_init(AVBSFContext *bsf)
+{
+    const PelorusFGSContext *ctx = bsf->priv_data;
+    int bd_luma = 0, bd_chroma = 0;
+    int err;
+
+    if (ctx->intensity_low > ctx->intensity_high || ctx->intensity_low_c > ctx->intensity_high_c) {
+        av_log(bsf, AV_LOG_ERROR,
+               "pelorus_fgs: empty intensity interval (luma %d..%d, chroma %d..%d): a lower "
+               "bound above its upper bound matches no sample, so no grain is synthesized.\n",
+               ctx->intensity_low, ctx->intensity_high, ctx->intensity_low_c,
+               ctx->intensity_high_c);
+        return AVERROR(EINVAL);
+    }
+
+    if (ctx->components) {
+        pel_fgs_warn_profile(bsf);
+        if (pel_fgs_par_bit_depth(bsf->par_in, &bd_luma, &bd_chroma)) {
+            err = pel_fgs_check_scales(bsf, bd_luma, bd_chroma, "from the codec parameters",
+                                       AV_LOG_ERROR);
+            if (err < 0)
+                return err;
+        }
+    }
+
+    return ff_cbs_bsf_generic_init(bsf, &pel_fgs_type);
+}
+
+/* The ffmpeg CLI logs a failed packet and keeps going unless -xerror is set, so
+ * say once, loudly, that the output is now missing access units. */
+static int pel_fgs_filter(AVBSFContext *bsf, AVPacket *pkt)
+{
+    PelorusFGSContext *ctx = bsf->priv_data;
+    int err = ff_cbs_bsf_generic_filter(bsf, pkt);
+
+    if (err < 0 && err != AVERROR(EAGAIN) && err != AVERROR_EOF && !ctx->logged_drop) {
+        ctx->logged_drop = 1;
+        av_log(bsf, AV_LOG_ERROR,
+               "pelorus_fgs: dropping access unit (%s); the output is incomplete. The ffmpeg "
+               "CLI skips failed packets unless -xerror is given.\n",
+               av_err2str(err));
+    }
+    return err;
+}
