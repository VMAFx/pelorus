--- a/libavcodec/qsvenc.h
+++ b/libavcodec/qsvenc.h
@@ -39,6 +39,15 @@
 #define QSV_HAVE_EXT_VP9_TILES QSV_VERSION_ATLEAST(1, 29)
 #define QSV_HAVE_EXT_AV1_PARAM QSV_VERSION_ATLEAST(2, 5)
 
+/* Pelorus: per-block delta-QP steering via mfxExtMBQP. The buffer, its
+ * MFX_EXTBUFF_MBQP id and mfxExtCodingOption3::EnableMBQP all exist from
+ * MediaSDK / oneVPL API 1.13 onward; gate on it so older SDK headers compile
+ * without the dense path (the AVOption then selects stock EncoderROI). The
+ * MBQP DeltaQP array is documented as 16x16-block-aligned, raster order. */
+#ifndef QSV_HAVE_MBQP
+#define QSV_HAVE_MBQP  QSV_VERSION_ATLEAST(1, 13)
+#endif
+
 #if defined(_WIN32) || defined(__CYGWIN__)
 #define QSV_HAVE_AVBR   1
 #define QSV_HAVE_VCM    1
@@ -265,6 +274,18 @@ typedef struct QSVEncContext {
     char *load_plugins;
     SetEncodeCtrlCB *set_encode_ctrl_cb;
     int forced_idr;
+
+    /* Pelorus: per-block QP steering from AV_FRAME_DATA_REGIONS_OF_INTEREST,
+     * gated by the "pelorus_roi" AVOption (default off). When enabled at init
+     * (progressive HEVC under CQP on runtime API 1.28 or newer) we turn on
+     * mfxExtCodingOption3::EnableMBQP and rasterize each frame's ROI side data
+     * into a per-frame mfxExtMBQP that carries its own delta-QP map (one signed
+     * byte per 16x16 block, raster order). The map must not be shared between
+     * frames: EncodeFrameAsync keeps it live until the frame completes. */
+    int pelorus_roi;
+    int pelorus_roi_mbqp_enabled; ///< final attached EnableMBQP is ON
+    int roi_warned;            ///< rate-limit ext-buffer-slot warnings to once
+    int roi_interlaced_warned; ///< rate-limit per-frame fallback warnings to once
     int low_delay_brc;
 
     int co2_idx;
