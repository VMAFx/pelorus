+/* Pelorus: NVENC writes a SEI payload truncated once its emulation prevention
+ * bytes exceed about a third of its size (issue #284), which the zero runs of
+ * flat analyze maps reach, and nvenc_drop_truncated_udu_sei() then leaves it
+ * out. Every Pelorus blob is therefore written in its zero-free carrier form
+ * (interop ABI 1.5, ADR-0183, pelorus_sei_fit.h): it holds no zero byte, needs
+ * no emulation prevention and is never truncated. Any other payload stays as
+ * copied. `sei` holds the av_memdup() copy of one side data entry. With a
+ * `budget` (hevc_nvenc: what is left of the picture's SEI share), a blob whose
+ * carrier does not fit first loses the per-cell maps appended after its
+ * sections, in that copy (ADR-0181); nvenc_hevc_sei_fits() then charges the
+ * carrier or drops it. SIZE_MAX means no budget (h264_nvenc). */
+static int pelorus_udu_carrier(AVCodecContext *avctx, const AVFrame *frame,
+                               NV_ENC_SEI_PAYLOAD *sei, size_t budget)
+{
+    NvencContext *ctx = avctx->priv_data;
+    const size_t size = sei->payloadSize;
+    size_t keep = size;
+    size_t len;
+    uint8_t *carrier;
+
+    if (!pel_sei_is_blob(sei->payload, size))
+        return 0;
+    if (budget != SIZE_MAX) {
+        keep = pel_sei_fit_len(sei->payload, size, budget);
+        if (keep && keep < size)
+            pel_sei_strip_maps(sei->payload, keep);
+        else
+            keep = size;
+    }
+    len = pel_sei_carrier_len(sei->payload, keep);
+    if ((uint64_t)len > UINT32_MAX)
+        return AVERROR(EINVAL);
+    carrier = av_malloc(len);
+    if (!carrier)
+        return AVERROR(ENOMEM);
+    pel_sei_carrier_write(sei->payload, keep, carrier);
+    av_free(sei->payload);
+    sei->payload     = carrier;
+    sei->payloadSize = (uint32_t)len;
+
+    if (keep < size && pel_sei_nal_bytes(carrier, len, budget) <= budget) {
+        av_log(avctx, ctx->pelorus_udu_stripped ? AV_LOG_VERBOSE : AV_LOG_WARNING,
+               "udu_sei: frame pts %"PRId64": the %zu-byte Pelorus side data is "
+               "written without its per-cell maps (%zu bytes): hevc_nvenc writes "
+               "at most %u bytes of parameter sets and SEI per picture.\n",
+               frame->pts, size, keep, PEL_SEI_HEVC_NVENC_CAP);
+        ctx->pelorus_udu_stripped++;
+    }
+    if (!ctx->pelorus_udu_carrier_logged) {
+        ctx->pelorus_udu_carrier_logged = 1;
+        av_log(avctx, AV_LOG_VERBOSE, "udu_sei: Pelorus side data is written "
+               "in its zero-free carrier form (UUID "
+               "3f9b37b8-fd9a-4621-920e-9b78b55cf9b5), which needs no emulation "
+               "prevention.\n");
+    }
+    return 0;
+}
+
