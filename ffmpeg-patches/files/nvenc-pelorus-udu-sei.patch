             ctx->sei_data[sei_count].payload = av_memdup(side_data->data, side_data->size);
 
+            res = pelorus_udu_carrier(avctx, frame, ctx->sei_data, sei_count);
+            if (res < 0)
+                goto error;
+            if (res > 0)
+                continue;
+
             if (!ctx->sei_data[sei_count].payload) {
                 res = AVERROR(ENOMEM);
                 goto error;
