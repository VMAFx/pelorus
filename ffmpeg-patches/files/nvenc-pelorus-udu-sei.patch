@@ -328,6 +328,15 @@ typedef struct NvencContext
     int     me_hints_h;      ///< 16x16 blocks down  = ceil(height / 16)
     int     me_hints_warned; ///< rate-limit the AQ/lookahead note to once
     int     me_hints_absent_warned; ///< rate-limit the "frame had no motion data" warning
+
+    /* Pelorus: with udu_sei on hevc_nvenc, side-data payloads that do not fit
+     * the per-picture header limit (pelorus_sei_fit.h, ADR-0181). The first of
+     * each kind is a warning, later ones verbose, the totals a warning at close.
+     * On both codecs Pelorus blobs go out in the zero-free carrier form
+     * (ADR-0183). */
+    int64_t pelorus_udu_stripped; ///< Pelorus blobs written without their maps
+    int64_t pelorus_udu_dropped;  ///< SEI payloads not written at all
+    int     pelorus_udu_carrier_logged; ///< the zero-free carrier note was given (ADR-0183)
 } NvencContext;
 
