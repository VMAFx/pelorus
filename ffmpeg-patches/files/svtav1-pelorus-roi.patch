@@ -70,6 +78,62 @@ typedef struct SvtContext {
 
     uint8_t *stats_buf;
 
+    /* Pelorus: per-region QP steering from AV_FRAME_DATA_REGIONS_OF_INTEREST
+     * (the side data vf_pelorus_analyze roi=1 emits). Gated by the
+     * "pelorus_roi" AVOption (default off) and the SVT-AV1 1.6.0+ ROI-map ABI
+     * (enable_roi_map + the ROI_MAP_EVENT priv-data type). When enabled we flip
+     * enable_roi_map before set_parameter, then per frame rasterize the ROI
+     * rectangles into SVT-AV1's per-64x64-superblock segment map: each frame
+     * gets a freshly-allocated SvtAv1RoiMapEvt whose b64_seg_map indexes up to
+     * MAX_SEGMENTS distinct seg_qp[] delta-qindex values. Negative seg_qp means
+     * lower qindex / more bits, matching AVRegionOfInterest.qoffset's negative=
+     * better-quality convention.
+     *
+     * Lifetime: svt_av1_enc_send_picture() shallow-copies the EbPrivDataNode but
+     * keeps node->data (the SvtAv1RoiMapEvt*) live and dereferences it later on
+     * async pipeline threads (resource_coordination_process.c stores the bare
+     * pointer into enc_ctx->roi_map_evt). A single reused buffer would race the
+     * lookahead, so each ROI-bearing frame owns its event + seg_map. NOTE:
+     * SvtAv1RoiMapEvt.next is the *library's* own event-chain field, so we must
+     * never thread our free-list through it (the library would follow it into a
+     * stale prior-frame event); we keep a separate owning queue.
+     *
+     * Reclamation: the library never frees or copies an ROI event (the
+     * EbPrivDataNode is copied shallowly, see enc_handle.c); it keeps the bare
+     * pointer in enc_ctx->roi_map_evt, which is sticky (a later frame without
+     * an ROI node inherits it), and in each PictureParentControlSet until that
+     * picture is encoded. So an event is dead once (a) a newer event replaced it
+     * as the sticky one and (b) every frame submitted before that newer event
+     * has been encoded. Packets leave the library in decode order, one per
+     * shown frame, and a mini-GOP is at most 64 frames, so after P packets all
+     * frames with input index < P - 64 are done; we reclaim with a margin of
+     * twice that. The newest event is never reclaimed before close.
+     *
+     * Because the event is sticky, a frame without ROI data (or with a map that
+     * resolves to all-zero deltas) would silently inherit the previous frame's
+     * ROI. SVT-AV1 documents no reset call, so on the first such frame after a
+     * non-neutral event we submit a neutral event (all-zero segment map, zero
+     * delta) that replaces the sticky one; later frames inherit that neutral map
+     * and need no event of their own.
+     *
+     * The members carry a pelorus_ prefix because the shared FFmpeg fix
+     * series' -qpfile bridge keeps its own roi_evts / roi_b64_* in this
+     * context. The two bridges share no state. This bridge attaches its node
+     * before the qpfile bridge runs, so with both enabled a frame the qpfile
+     * covers is encoded with the qpfile map. */
+    int pelorus_roi;
+#if SVT_AV1_CHECK_VERSION(1, 6, 0)
+    struct PelorusSvtRoiSlot *pelorus_roi_evts; ///< live ROI events, oldest first
+    int              pelorus_roi_nevts;    ///< number of live entries in pelorus_roi_evts
+    uint64_t         pelorus_roi_nframes;  ///< frames submitted to the encoder
+    uint64_t         pelorus_roi_npackets; ///< packets received from the encoder
+    uint64_t         pelorus_roi_nbuilt;   ///< ROI events built (stats)
+    int              pelorus_roi_peak;     ///< peak live events (stats)
+    int              pelorus_roi_sticky;   ///< the library's sticky ROI event is non-neutral
+    unsigned int     pelorus_roi_b64_cols; ///< superblocks across = ceil(width  / 64)
+    unsigned int     pelorus_roi_b64_rows; ///< superblocks down   = ceil(height / 64)
+#endif
+
     // User options.
     AVDictionary *svtav1_opts;
     int enc_mode;
@@ -441,8 +505,280 @@ static int config_enc_params(EbSvtAv1EncConfiguration *param,
         cpb_props->avg_bitrate = avctx->bit_rate;
     }
 
+    if (svt_enc->pelorus_roi) {
+#if SVT_AV1_CHECK_VERSION(1, 6, 0)
+        svt_enc->pelorus_roi_b64_cols = ((unsigned)avctx->width  + 63u) / 64u;
+        svt_enc->pelorus_roi_b64_rows = ((unsigned)avctx->height + 63u) / 64u;
+        param->enable_roi_map = 1;
+        av_log(avctx, AV_LOG_VERBOSE,
+               "Pelorus ROI map enabled: %ux%u superblocks (64 px/SB).\n",
+               svt_enc->pelorus_roi_b64_cols, svt_enc->pelorus_roi_b64_rows);
+#else
+        av_log(avctx, AV_LOG_WARNING,
+               "pelorus_roi requested but the SVT-AV1 ROI-map ABI is "
+               "unavailable (SVT-AV1 1.6.0 or greater required at compile "
+               "time); ignoring.\n");
+        svt_enc->pelorus_roi = 0;
+#endif
+    }
+
+    return 0;
+}
+
+#if SVT_AV1_CHECK_VERSION(1, 6, 0)
+/* Pelorus: maximum AV1 segments (MAX_SEGMENTS = 8); seg_qp[] holds this many
+ * delta-qindex values. */
+#define PELORUS_SVTAV1_MAX_SEGMENTS 8
+/* Pelorus: SVT-AV1's ROI segment map is per-64x64 superblock. */
+#define PELORUS_SVTAV1_SB_SIZE      64
+
+/* Pelorus: margin (in frames) between a packet count and the oldest frame whose
+ * ROI event may still be read by the library: twice the 64-frame maximum
+ * mini-GOP (see the lifetime note in SvtContext). */
+#define PELORUS_SVTAV1_ROI_RECLAIM_MARGIN 128
+
+static void svtav1_free_roi_evt(SvtAv1RoiMapEvt *evt)
+{
+    av_free(evt->b64_seg_map);
+    av_free(evt);
+}
+
+/* Pelorus: free the ROI events the library can no longer reference. Event i is
+ * dead when event i+1 (the next sticky one) was submitted at input index n and
+ * n + margin <= packets received, i.e. every frame before n is encoded. The
+ * newest event stays live: the library may still hand it to later frames. */
+static void svtav1_reclaim_roi_evts(SvtContext *svt_enc)
+{
+    int dead = 0;
+
+    while (dead + 1 < svt_enc->pelorus_roi_nevts &&
+           svt_enc->pelorus_roi_evts[dead + 1].seq + PELORUS_SVTAV1_ROI_RECLAIM_MARGIN <=
+               svt_enc->pelorus_roi_npackets)
+        dead++;
+    if (!dead)
+        return;
+
+    for (int i = 0; i < dead; i++)
+        svtav1_free_roi_evt(svt_enc->pelorus_roi_evts[i].evt);
+    memmove(svt_enc->pelorus_roi_evts, svt_enc->pelorus_roi_evts + dead,
+            (size_t)(svt_enc->pelorus_roi_nevts - dead) * sizeof(*svt_enc->pelorus_roi_evts));
+    svt_enc->pelorus_roi_nevts -= dead;
+}
+
+/* Pelorus: queue an event on pelorus_roi_evts (reclaimed by svtav1_reclaim_roi_evts(),
+ * the rest freed in eb_enc_close()) and record whether it is the non-neutral
+ * sticky one. Takes ownership of evt on success only. */
+static int svtav1_push_roi_evt(SvtContext *svt_enc, SvtAv1RoiMapEvt *evt,
+                               int neutral)
+{
+    struct PelorusSvtRoiSlot *tmp;
+
+    svtav1_reclaim_roi_evts(svt_enc);
+    tmp = av_realloc_array(svt_enc->pelorus_roi_evts,
+                           (size_t)svt_enc->pelorus_roi_nevts + 1, sizeof(*tmp));
+    if (!tmp)
+        return AVERROR(ENOMEM);
+    svt_enc->pelorus_roi_evts = tmp;
+    svt_enc->pelorus_roi_evts[svt_enc->pelorus_roi_nevts].evt = evt;
+    svt_enc->pelorus_roi_evts[svt_enc->pelorus_roi_nevts].seq = svt_enc->pelorus_roi_nframes;
+    svt_enc->pelorus_roi_nevts++;
+    svt_enc->pelorus_roi_nbuilt++;
+    if (svt_enc->pelorus_roi_nevts > svt_enc->pelorus_roi_peak)
+        svt_enc->pelorus_roi_peak = svt_enc->pelorus_roi_nevts;
+    svt_enc->pelorus_roi_sticky = !neutral;
+    return 0;
+}
+
+/* Pelorus: a frame without usable ROI data must not inherit the sticky event of
+ * an earlier frame. When the sticky event is non-neutral, build and queue a
+ * neutral one (every superblock in segment 0, zero delta); otherwise nothing
+ * to do (*out_evt stays NULL). */
+static int svtav1_neutral_roi_evt(SvtContext *svt_enc, int64_t pts,
+                                  SvtAv1RoiMapEvt **out_evt)
+{
+    SvtAv1RoiMapEvt *evt;
+    uint8_t *seg_map;
+    int ret;
+
+    *out_evt = NULL;
+    if (!svt_enc->pelorus_roi_sticky)
+        return 0;
+
+    evt     = av_mallocz(sizeof(*evt));
+    seg_map = av_calloc((size_t)svt_enc->pelorus_roi_b64_cols * svt_enc->pelorus_roi_b64_rows,
+                        sizeof(*seg_map));
+    if (!evt || !seg_map) {
+        av_free(seg_map);
+        av_free(evt);
+        return AVERROR(ENOMEM);
+    }
+    evt->start_picture_number = pts >= 0 ? (uint64_t)pts : 0;
+    evt->b64_seg_map          = seg_map;
+    evt->max_seg_id           = 0;
+    evt->next                 = NULL;
+    ret = svtav1_push_roi_evt(svt_enc, evt, 1);
+    if (ret < 0) {
+        svtav1_free_roi_evt(evt);
+        return ret;
+    }
+    *out_evt = evt;
+    return 0;
+}
+
+/* Pelorus: rasterize AV_FRAME_DATA_REGIONS_OF_INTEREST into one SvtAv1RoiMapEvt
+ * for this frame and push it onto svt_enc->pelorus_roi_evts (reclaimed by
+ * svtav1_reclaim_roi_evts(), the rest freed in eb_enc_close()).
+ * Mirrors the NVENC/QSV ROI patches' rectangle iteration: regions are walked in
+ * reverse so the first region in the list wins on overlap; each
+ * AVRegionOfInterest.qoffset (an AVRational in [-1, +1], negative asks for lower
+ * qindex / more bits) is scaled by the AV1 qindex span (255) and clamped.
+ *
+ * SVT-AV1 differs from the per-block delta map NVENC/QSV use: it consumes a
+ * dense per-superblock *segment* map (b64_seg_map) plus up to 8 segment qindex
+ * deltas (seg_qp[]). We therefore quantise the per-SB delta into <= 8 buckets,
+ * emit a seg_qp[] table of the distinct bucket deltas and a b64_seg_map of
+ * segment ids. Segment 0 is reserved for the zero delta (background), so an SB
+ * no region covers keeps the encoder's default rate-control decision.
+ *
+ * On success attaches the event to *out_evt for the caller to wire into the
+ * EbPrivDataNode. A frame with no usable ROI data gets a neutral event only
+ * when an earlier non-neutral one is still the library's sticky event; else
+ * *out_evt stays NULL and the encoder sees the unchanged frame qindex. */
+static int svtav1_build_roi_evt(AVCodecContext *avctx, const AVFrame *frame,
+                                SvtAv1RoiMapEvt **out_evt)
+{
+    SvtContext *svt_enc = avctx->priv_data;
+    AVFrameSideData *sd;
+    const AVRegionOfInterest *roi;
+    SvtAv1RoiMapEvt *evt;
+    uint8_t *seg_map;
+    int16_t seg_qp[PELORUS_SVTAV1_MAX_SEGMENTS] = { 0 };
+    unsigned cols = svt_enc->pelorus_roi_b64_cols;
+    unsigned rows = svt_enc->pelorus_roi_b64_rows;
+    size_t map_size = (size_t)cols * rows;
+    uint32_t roi_size;
+    int nb_rois, n_seg = 1; /* seg 0 == background (zero delta) */
+    int ret;
+    const AVPixFmtDescriptor *desc;
+    int bit_depth, qp_range;
+    const int blk = PELORUS_SVTAV1_SB_SIZE;
+
+    *out_evt = NULL;
+    if (!svt_enc->pelorus_roi || !frame || cols == 0 || rows == 0)
+        return 0;
+
+    sd = av_frame_get_side_data(frame, AV_FRAME_DATA_REGIONS_OF_INTEREST);
+    if (!sd)
+        return svtav1_neutral_roi_evt(svt_enc, frame->pts, out_evt);
+
+    roi = (const AVRegionOfInterest *)sd->data;
+    roi_size = roi->self_size;
+    if (!roi_size || sd->size % roi_size != 0) {
+        av_log(avctx, AV_LOG_ERROR, "Invalid AVRegionOfInterest.self_size.\n");
+        return AVERROR(EINVAL);
+    }
+    nb_rois = sd->size / roi_size;
+
+    desc = av_pix_fmt_desc_get(avctx->pix_fmt);
+    bit_depth = desc ? desc->comp[0].depth : 8;
+    /* AV1 qindex is a 0..255 scale regardless of bit depth; the qoffset maps
+     * onto a fraction of that full span. (We do not use the 51+6*(bd-8) H.26x
+     * range here because SVT-AV1's seg_qp is a qindex delta, not a QP delta.) */
+    (void)bit_depth;
+    qp_range = 255;
+
+    evt = av_mallocz(sizeof(*evt));
+    if (!evt)
+        return AVERROR(ENOMEM);
+    seg_map = av_calloc(map_size, sizeof(*seg_map));
+    if (!seg_map) {
+        av_free(evt);
+        return AVERROR(ENOMEM);
+    }
+
+    /* Reverse iteration: the first region in the list takes precedence on
+     * overlap, so writing it last lets it overwrite later regions. */
+    for (int i = nb_rois - 1; i >= 0; i--) {
+        int startx, endx, starty, endy, seg_id;
+        float qoffset;
+        int16_t delta;
+
+        roi = (const AVRegionOfInterest *)(sd->data + (size_t)roi_size * i);
+        if (roi->qoffset.den == 0) {
+            av_log(avctx, AV_LOG_ERROR,
+                   "AVRegionOfInterest.qoffset.den must not be zero.\n");
+            av_free(seg_map);
+            av_free(evt);
+            return AVERROR(EINVAL);
+        }
+
+        starty = av_clip(roi->top    / blk,             0, (int)rows);
+        endy   = av_clip((roi->bottom + blk - 1) / blk, 0, (int)rows);
+        startx = av_clip(roi->left   / blk,             0, (int)cols);
+        endx   = av_clip((roi->right  + blk - 1) / blk, 0, (int)cols);
+
+        qoffset = roi->qoffset.num * 1.0f / roi->qoffset.den;
+        delta = (int16_t)av_clip(lrintf(av_clipf(qoffset * qp_range,
+                                                 -qp_range, qp_range)),
+                                 -qp_range, qp_range);
+        if (delta == 0)
+            continue; /* zero delta is segment 0 already */
+
+        /* Find or allocate a segment id for this delta. */
+        seg_id = -1;
+        for (int s = 1; s < n_seg; s++) {
+            if (seg_qp[s] == delta) { seg_id = s; break; }
+        }
+        if (seg_id < 0) {
+            if (n_seg >= PELORUS_SVTAV1_MAX_SEGMENTS) {
+                /* Segment budget exhausted: snap to the nearest existing
+                 * non-background segment so the region still gets biased. */
+                int best = 1, best_d = INT_MAX;
+                for (int s = 1; s < n_seg; s++) {
+                    int d = FFABS((int)seg_qp[s] - (int)delta);
+                    if (d < best_d) { best_d = d; best = s; }
+                }
+                seg_id = best;
+            } else {
+                seg_id = n_seg;
+                seg_qp[n_seg++] = delta;
+            }
+        }
+
+        for (int y = starty; y < endy; y++)
+            for (int x = startx; x < endx; x++)
+                seg_map[(size_t)y * cols + x] = (uint8_t)seg_id;
+    }
+
+    if (n_seg <= 1) {
+        /* Every region resolved to delta 0: an all-background map. Hand the
+         * encoder a neutral event only if it would otherwise keep an earlier
+         * non-neutral one. */
+        av_free(seg_map);
+        av_free(evt);
+        return svtav1_neutral_roi_evt(svt_enc, frame->pts, out_evt);
+    }
+
+    evt->start_picture_number = frame->pts >= 0 ? (uint64_t)frame->pts : 0;
+    evt->b64_seg_map          = seg_map;
+    evt->max_seg_id           = (int8_t)(n_seg - 1);
+    for (int s = 0; s < n_seg; s++)
+        evt->seg_qp[s] = seg_qp[s];
+    /* SvtAv1RoiMapEvt.next is the library's own event-chain field: leave it NULL
+     * or SVT-AV1 walks it into a previous frame's event. Own the event for the
+     * whole session via a separate array (the encoder keeps the pointer live
+     * across the async pipeline). */
+    evt->next = NULL;
+    ret = svtav1_push_roi_evt(svt_enc, evt, 0);
+    if (ret < 0) {
+        av_free(seg_map);
+        av_free(evt);
+        return ret;
+    }
+    *out_evt = evt;
     return 0;
 }
+#endif /* SVT_AV1_CHECK_VERSION(1, 6, 0) */
 
