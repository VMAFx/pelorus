diff --git a/libavcodec/qsvenc.c b/libavcodec/qsvenc.c
index a7e1a5521b..a494f98d69 100644
--- a/libavcodec/qsvenc.c
+++ b/libavcodec/qsvenc.c
@@ -40,6 +40,7 @@
 #include "encode.h"
 #include "qsv.h"
 #include "qsv_internal.h"
+#include "pelorus_sei_fit_qsv.h"
 #include "qsvenc.h"
 #include "libavutil/refstruct.h"
 
@@ -1956,22 +1957,63 @@ int ff_qsv_enc_init(AVCodecContext *avctx, QSVEncContext *q)
     return 0;
 }
 
+/* Pelorus: the QSV runtime reserves a fixed SEI space per picture and damages
+ * the access unit or fails the encode beyond it (issue #286,
+ * pelorus_sei_fit_qsv.h). Return what is left of it after the payloads already
+ * in enc_ctrl (the A/53 caption payload). */
+static size_t qsvenc_udu_budget(const AVCodecContext *avctx, const mfxEncodeCtrl *enc_ctrl)
+{
+    size_t budget = avctx->codec_id == AV_CODEC_ID_HEVC ? PEL_SEI_QSV_HEVC_BUDGET
+                                                         : PEL_SEI_QSV_H264_BUDGET;
+
+    for (int i = 0; i < enc_ctrl->NumPayload && i < QSV_MAX_ENC_PAYLOAD; i++) {
+        const size_t used = enc_ctrl->Payload[i]->BufSize;
+        budget = used < budget ? budget - used : 0;
+    }
+    return budget;
+}
+
+static void qsvenc_udu_log(AVCodecContext *avctx, QSVEncContext *q, const AVFrame *frame,
+                           const AVFrameSideData *sd, size_t kept)
+{
+    int first = kept ? !q->udu_sei_stripped : !q->udu_sei_dropped;
+    int level = first ? AV_LOG_WARNING : AV_LOG_VERBOSE;
+
+    if (kept) {
+        q->udu_sei_stripped++;
+        av_log(avctx, level, "udu_sei: frame pts %"PRId64": the %zu-byte Pelorus side "
+               "data is written without its per-cell maps (%zu bytes): the QSV runtime "
+               "reserves too little SEI space per picture for more.\n",
+               frame->pts, sd->size, kept);
+    } else {
+        q->udu_sei_dropped++;
+        av_log(avctx, level, "udu_sei: frame pts %"PRId64": a %zu-byte user data "
+               "unregistered SEI is not written: it does not fit the SEI space the QSV "
+               "runtime reserves per picture.\n", frame->pts, sd->size);
+    }
+}
+
 /**
  * Append one SEI user-data-unregistered payload (type 5) per
  * AV_FRAME_DATA_SEI_UNREGISTERED side-data entry of the frame to enc_ctrl, in
  * the slots the stock A/53 callback left free. The payload buffer carries the
  * SEI message header (type, size) in front of the UUID and data, like the A/53
  * payload in qsvenc_h264.c. Freed with the other payloads in free_encoder_ctrl.
+ * A payload that does not fit the picture's SEI budget is written without the
+ * maps of a Pelorus blob, or not at all (pel_sei_qsv_fit()).
  */
 static int qsvenc_add_udu_payloads(AVCodecContext *avctx, QSVEncContext *q,
                                    const AVFrame *frame, mfxEncodeCtrl *enc_ctrl)
 {
+    const int escaped = avctx->codec_id != AV_CODEC_ID_HEVC;
+    size_t budget = qsvenc_udu_budget(avctx, enc_ctrl);
+
     for (int i = 0; i < frame->nb_side_data; i++) {
         const AVFrameSideData *sd = frame->side_data[i];
-        size_t hdr = 2 + sd->size / 255;
+        const size_t hdr = 2 + sd->size / 255;
         mfxPayload *payload;
         mfxU8 *data;
-        size_t size;
+        size_t keep, hdr_keep, cost;
 
         if (sd->type != AV_FRAME_DATA_SEI_UNREGISTERED || sd->size < 16)
             continue;
@@ -1987,20 +2029,35 @@ static int qsvenc_add_udu_payloads(AVCodecContext *avctx, QSVEncContext *q,
         /* NumBit is an mfxU32: payload size in bits must not overflow it. */
         if (sd->size > UINT32_MAX / 8 - 16)
             return AVERROR(EINVAL);
-        size = hdr + sd->size;
-        payload = av_mallocz(sizeof(*payload) + size);
+        keep = pel_sei_qsv_plan(sd->data, sd->size, escaped, budget);
+        if (!keep) {
+            qsvenc_udu_log(avctx, q, frame, sd, 0);
+            continue;
+        }
+        payload = av_mallocz(sizeof(*payload) + hdr + sd->size);
         if (!payload)
             return AVERROR(ENOMEM);
-        data    = (mfxU8 *)(payload + 1);
-        data[0] = 5;                       /* user_data_unregistered */
-        memset(data + 1, 0xFF, sd->size / 255);
-        data[1 + sd->size / 255] = sd->size % 255;
-        memcpy(data + hdr, sd->data, sd->size);
-
-        payload->BufSize = size;
-        payload->NumBit  = size * 8;
+        data = (mfxU8 *)(payload + 1);
+        keep = pel_sei_qsv_fit(sd->data, sd->size, escaped, budget, data + hdr);
+        if (keep < sd->size)
+            qsvenc_udu_log(avctx, q, frame, sd, keep);
+        if (!keep) {
+            av_free(payload);
+            continue;
+        }
+        /* The header is shorter for a stripped payload: right-align it. */
+        hdr_keep = 2 + keep / 255;
+        data    += hdr - hdr_keep;
+        data[0]  = 5;                      /* user_data_unregistered */
+        memset(data + 1, 0xFF, keep / 255);
+        data[1 + keep / 255] = keep % 255;
+
+        payload->BufSize = hdr_keep + keep;
+        payload->NumBit  = payload->BufSize * 8;
         payload->Type    = 5;
         payload->Data    = data;
+        cost   = pel_sei_qsv_cost(data + hdr_keep, keep, escaped, budget);
+        budget = cost < budget ? budget - cost : 0;
         enc_ctrl->Payload[enc_ctrl->NumPayload++] = payload;
     }
     return 0;
@@ -3058,6 +3115,14 @@ int ff_qsv_enc_close(AVCodecContext *avctx, QSVEncContext *q)
 {
     QSVFrame *cur;
 
+    if (q->udu_sei_stripped || q->udu_sei_dropped)
+        av_log(avctx, AV_LOG_WARNING, "udu_sei: %"PRId64" frame(s) carried Pelorus side "
+               "data without its per-cell maps and %"PRId64" user data unregistered SEI "
+               "payload(s) were not written, to stay within the SEI space the QSV "
+               "runtime reserves per picture (%u bytes for HEVC, %u for H.264).\n",
+               q->udu_sei_stripped, q->udu_sei_dropped,
+               PEL_SEI_QSV_HEVC_BUDGET, PEL_SEI_QSV_H264_BUDGET);
+
     if (q->session)
         MFXVideoENCODE_Close(q->session);
 
