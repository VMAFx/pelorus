+ * (it may fall back to a host fill), one map image per exec-pool context, and
+ * the host raster scratch. A failure clears qpmap_enabled, so the session is
+ * created without the QP-map flags and the encoder passes through. */
+static void pelorus_qpmap_init(AVCodecContext *avctx, FFVulkanEncodeContext *ctx)
+{
+#if CONFIG_PELORUS_QPMAP_GPU
