+/* Copy fill (PELORUS_QPMAP_FILL_COPY; also the fallback when the shader build
+ * failed): raster the ROI rect list into a staging buffer, then upload it into
+ * the device-local quant-map image with vkCmdCopyBufferToImage on the encode
+ * command buffer, leaving the image in
+ * VK_IMAGE_LAYOUT_VIDEO_ENCODE_QUANTIZATION_MAP_KHR ready for the encode. Only
+ * chosen when the encode queue family supports the copy. Records on the passed
+ * exec; the staging buffer is kept alive as an exec dependency. Returns 0. */
+static int pelorus_qpmap_upload(AVCodecContext *avctx, FFVulkanEncodeContext *ctx,
+                                FFVkExecContext *exec, int slot,
+                                const PelorusQpRect *rects, int nb_rects)
+{
+    int err;
+    FFVulkanContext *s = &ctx->s;
+    FFVulkanFunctions *vk = &s->vkfn;
+    AVBufferRef *stage_ref = NULL;
+    FFVkBuffer *stage;
+    size_t pitch = (size_t)ctx->qpmap_w * ctx->qpmap_texel_bytes;
