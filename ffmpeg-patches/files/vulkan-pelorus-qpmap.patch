+        ctx->qpmap_scratch_size = ctx->qpmap_w * ctx->qpmap_h;
+        ctx->qpmap_scratch = av_calloc(ctx->qpmap_scratch_size,
+                                       sizeof(*ctx->qpmap_scratch));
