diff --git a/libavcodec/vulkan/pelorus_qpmap.comp.glsl b/libavcodec/vulkan/pelorus_qpmap.comp.glsl
new file mode 100644
index 0000000000..97e545732f
--- /dev/null
+++ b/libavcodec/vulkan/pelorus_qpmap.comp.glsl
@@ -0,0 +1,125 @@
+/*
+ * Copyright 2026 Lusoris
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or modify it under
+ * the terms of the GNU Lesser General Public License as published by the
+ * Free Software Foundation; either version 2.1 of the License, or (at
+ * your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful, but WITHOUT
+ * ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or
+ * FITNESS FOR A PARTICULAR PURPOSE. See the GNU Lesser General Public
+ * License for more details.
+ */
+
+/*
+ * Pelorus on-GPU quantization-map rasterizer (ADR-0114 Tier 2).
+ *
+ * Writes the VK_KHR_video_encode_quantization_map texel image DIRECTLY on the
+ * GPU from the coalesced ROI rectangle list, eliminating the host per-texel
+ * raster + staging upload of the original v0.1.0 path. The host uploads only
+ * the compact rectangle list (tens of structs) into a small SSBO; this compute
+ * pass rasterizes it into the map, recorded on the encode command buffer.
+ *
+ * ONE INVOCATION PER MAP TEXEL: a dispatch of ceil(qpmap_w/16) x
+ * ceil(qpmap_h/16) workgroups covers the texel grid (W/texel.w by H/texel.h,
+ * commonly 16x16 or 32x32 px per texel, so it is tiny). Each invocation owns
+ * one texel, scans the rectangles in REVERSE so the first region wins on
+ * overlap (matching the host rasterizer and libx265's reverse iteration), and
+ * writes the winning delta-QP.
+ *
+ * Two driver-probed map kinds, selected by the `emphasis` push constant (the
+ * active image is bound by the host; the inactive binding gets a 1x1
+ * format-matching placeholder and is never written):
+ *   - DELTA map (R8_SINT) under CQP: the signed per-texel dQP, stored verbatim.
+ *   - EMPHASIS map (R8_UNORM) under CBR/VBR: a [0,1] value where a request for
+ *     *lower* QP (negative dQP, "spend more bits") becomes a *higher* emphasis.
+ *
+ * Rectangles arrive pre-clamped to texel-block units with the dQP already
+ * computed host-side in the SAME qoffset->dQP convention as the Tier-1
+ * NVENC/QSV patches (qoffset scaled by the codec QP range, clamped to the
+ * advertised dQP window) - so this shader is a pure rasterizer with no codec
+ * policy baked in.
+ *
+ * Single source of truth for the rasterizer. Before FFmpeg 9 this text lived
+ * twice: as an inline-GLSL string built at runtime inside vulkan_encode.c, and
+ * as a standalone reference .comp. FFmpeg 9 removed the runtime GLSL builder
+ * (GLSLC/GLSLF/GLSLD and ff_vk_shader_init), so the shader is compiled to
+ * SPIR-V at build time and linked in - which retires that duplication.
+ *
+ * The binding order below MUST match the FFVulkanDescriptorSetBinding array in
+ * pelorus_qpmap_build_shader() exactly; a mismatch is silent corruption, not a
+ * compile error.
+ */
+
+#pragma shader_stage(compute)
+
+/* Workgroup-size IDs 253/254/255 are reserved by ff_vk_shader_load(); the C
+ * side passes { 16, 16, 1 } and dispatches ceil(w/16) x ceil(h/16). */
+layout (local_size_x_id = 253, local_size_y_id = 254, local_size_z_id = 255) in;
+
+/* Delta map (signed, R8_SINT) and emphasis map (unorm, R8_UNORM). Only the
+ * binding selected by `emphasis` is written; both are declared because a
+ * storage-image descriptor must carry a view whose format matches the
+ * binding's qualifier. */
+layout (set = 0, binding = 0, r8i) uniform writeonly iimage2D deltaImg;
+layout (set = 0, binding = 1, r8)  uniform writeonly image2D  emphImg;
+
+/* One ROI rectangle per record, pre-clamped to texel-block units (the
+ * half-open box [x0,x1) x [y0,y1) in texels) with the signed dQP precomputed
+ * host-side. Mirrors PelorusQpRect in libavcodec/vulkan_encode.h: 8 ints,
+ * 32 bytes, std430. */
+struct QpRect {
+    int x0;
+    int y0;
+    int x1;
+    int y1;
+    int delta;   /* signed dQP in [qp_delta_min, qp_delta_max] */
+    int _pad0;
+    int _pad1;
+    int _pad2;
+};
+
+layout (set = 0, binding = 2, std430) readonly buffer RoiBuf {
+    QpRect rects[];
+};
+
+layout (push_constant, std430) uniform Params {
+    int width;        /*  0  map width  in texels                            */
+    int height;       /*  4  map height in texels                            */
+    int nb_rects;     /*  8  number of ROI rectangles in the SSBO            */
+    int emphasis;     /* 12  1 = write emphasis (R8_UNORM), 0 = delta (R8_SINT) */
+    int qp_delta_min; /* 16  clamp floor (for the emphasis normalization)    */
+    int qp_delta_max; /* 20  clamp ceil  (for the emphasis normalization)    */
+};
+
+void main()
+{
+    int x = int(gl_GlobalInvocationID.x);
+    int y = int(gl_GlobalInvocationID.y);
+    if (x >= width || y >= height)
+        return;
+
+    /* Reverse scan: the first ROI in the list wins on overlap. Default 0 (no
+     * region => neutral: no dQP / lowest emphasis), matching pass-through. */
+    int delta = 0;
+    for (int i = nb_rects - 1; i >= 0; i--) {
+        if (x >= rects[i].x0 && x < rects[i].x1 &&
+            y >= rects[i].y0 && y < rects[i].y1)
+            delta = rects[i].delta;
+    }
+
+    if (emphasis == 0) {
+        imageStore(deltaImg, ivec2(x, y), ivec4(delta, 0, 0, 0));
+    } else {
+        int range = qp_delta_max - qp_delta_min;
+        if (range <= 0)
+            range = 1;
+        /* lower QP (negative dQP) => more bits => higher emphasis */
+        float emph = float(-delta - qp_delta_min) / float(range);
+        emph = clamp(emph, 0.0, 1.0);
+        imageStore(emphImg, ivec2(x, y), vec4(emph, 0.0, 0.0, 0.0));
+    }
+}
diff --git a/libavcodec/vulkan_encode.c b/libavcodec/vulkan_encode.c
index 39c43300c4..e46cf613b9 100644
--- a/libavcodec/vulkan_encode.c
+++ b/libavcodec/vulkan_encode.c
@@ -28,6 +28,1394 @@ const AVCodecHWConfigInternal *const ff_vulkan_encode_hw_configs[] = {
     NULL,
 };
 
+/* ===== Pelorus: cross-vendor "via Vulkan" QP-map steering (ADR-0114 Tier 2) =====
+ *
+ * One Pelorus map producer (vf_pelorus_analyze roi=1, emitting the standard
+ * AV_FRAME_DATA_REGIONS_OF_INTEREST side data) steers bit allocation on every
+ * Vulkan-encode-capable GPU through VK_KHR_video_encode_quantization_map. The
+ * same ROI->dQP convention as the NVENC qpDeltaMap and QSV mfxExtMBQP patches
+ * (libavcodec/{nvenc,qsvenc}.c) is reused, so the proven analyze producer drives
+ * this path with no separate producer.
+ *
+ * Two driver-probed map kinds (the extension exposes both):
+ *   - DELTA map (R8_SINT, R16_SINT or R32_SINT, as advertised) under CQP: a
+ *     signed per-texel-block dQP added on top of the constant quantizer. This
+ *     is the high-fidelity path and the direct analogue of the Tier-1 NVENC/QSV
+ *     delta maps. NVIDIA advertises R8_SINT, RADV R32_SINT.
+ *   - EMPHASIS map (R8_UNORM or R16_UNORM) under CBR/VBR: a [0,1] per-block
+ *     emphasis where higher = "spend more bits here". analyze's 0..1 banding
+ *     score maps almost directly; we invert the (negative-for-better-quality)
+ *     ROI qoffset into it.
+ *
+ * Everything is runtime-probed and degrades to a one-shot warning + pass-through
+ * when the driver lacks the extension, the map mode, or a usable texel size - no
+ * device/box assumptions (product patch for all vendors). The whole path is also
+ * compile-gated by VK_KHR_video_encode_quantization_map so older Vulkan headers
+ * build to a clean no-op.
+ *
+ * CAVEAT (ADR-0114 Tier 2): driver coverage for this Nov-2024 extension is still
+ * uneven on Linux. On hardware lacking it (or lacking the encode-feedback flags
+ * vulkan_encode already requires at init) the encoder either degrades here or
+ * never reaches this code; that is a driver limitation, not a patch defect.
+ *
+ * FILL PATHS (ADR-0182). Every fill is recorded on the encode command buffer,
+ * so what may fill the map depends on the encode queue family:
+ *   - ON-GPU RASTER: the canonical build-time SPIR-V compute shader
+ *     (pelorus_qpmap.comp.glsl) reads the coalesced ROI rectangle list from a
+ *     small SSBO and imageStores the per-texel delta/emphasis. Needs
+ *     VK_QUEUE_COMPUTE_BIT on the encode queue family, STORAGE usage, and an
+ *     8-bit map format (the shader declares r8i / r8).
+ *   - COPY: host raster + staging buffer + vkCmdCopyBufferToImage. Needs a
+ *     transfer-, graphics- or compute-capable encode queue family and
+ *     TRANSFER_DST usage. NVIDIA (transfer on its encode family) uses it.
+ *   - HOST-MAPPED: the host rasterizes straight into a persistently mapped
+ *     LINEAR map image; the command buffer only changes its layout. Needs a
+ *     LINEAR entry and host-visible memory, nothing from the queue family.
+ *     RADV, whose encode family has VK_QUEUE_VIDEO_ENCODE_BIT_KHR only, uses
+ *     it.
+ * The probe asks the driver for the map usage together with the fill usages
+ * this queue family can record (drivers answer with the usages asked for) and
+ * picks the first path in the order above that an advertised entry allows.
+ */
+#ifdef VK_KHR_video_encode_quantization_map
+
+/* The rasterizer's GLSL lives in libavcodec/vulkan/pelorus_qpmap.comp.glsl and
+ * is compiled to SPIR-V at build time (glslc -> bin2c -> .spv.o), then linked
+ * in here. FFmpeg 9 removed the runtime GLSL builder (GLSLC/GLSLF/GLSLD and
+ * ff_vk_shader_init), which also retires the old inline-vs-reference lockstep
+ * duplication: the .comp.glsl is now the single source of truth.
+ *
+ * Compiling GLSL at build time needs a SPIR-V compiler, which is optional, so
+ * the whole on-GPU raster is gated on CONFIG_PELORUS_QPMAP_GPU (= vulkan_encode
+ * AND spirv_compiler). Without it vulkan/pelorus_qpmap.comp.spv.o is not built
+ * and these symbols do not exist; the host raster below covers the same
+ * functionality, so the encoder itself is never gated on a shader compiler. */
+#if CONFIG_PELORUS_QPMAP_GPU
+extern const unsigned char ff_pelorus_qpmap_comp_spv_data[];
+extern const unsigned int  ff_pelorus_qpmap_comp_spv_len;
+
+static int pelorus_qpmap_init_gpu(AVCodecContext *avctx,
+                                 FFVulkanEncodeContext *ctx);
+#endif
+
+/* ROI qoffset -> delta scale, per codec (same convention as the NVENC, QSV,
+ * libaom and SVT-AV1 Pelorus patches): H.264/H.265 span the QP range
+ * 51 + 6*(bit_depth-8); AV1 quantization-map deltas are qindex units (0..255)
+ * at every bit depth. qoffset is in [-1,+1], negative => lower QP / more bits.
+ * Scaling AV1 by the H.26x span would give a fifth of the requested delta. */
+static int pelorus_qp_range_for(enum AVCodecID codec_id, int bit_depth)
+{
+    if (codec_id == AV_CODEC_ID_AV1)
+        return 255;
+    return 51 + 6 * (bit_depth - 8);
+}
+
+static int pelorus_qp_range(AVCodecContext *avctx)
+{
+    const AVPixFmtDescriptor *desc = av_pix_fmt_desc_get(avctx->sw_pix_fmt);
+    int bit_depth = desc ? desc->comp[0].depth : 8;
+    return pelorus_qp_range_for(avctx->codec_id, bit_depth);
+}
+
+/* Query the quantization-map capabilities of this profile: the delta range the
+ * driver supports for DELTA maps (VkVideoEncode{H264,H265}QuantizationMap-
+ * CapabilitiesKHR::min/maxQpDelta or VkVideoEncodeAV1QuantizationMap-
+ * CapabilitiesKHR::min/maxQIndexDelta) and the largest map
+ * (VkVideoEncodeQuantizationMapCapabilitiesKHR::maxQuantizationMapExtent). A map
+ * texel outside the delta range leaves the block's QP undefined (Vulkan spec,
+ * the H.264/H.265/AV1 encode QP derivation), so the rasterizer clamps to it; a
+ * map image larger than the extent cannot be created
+ * (VUID-VkImageCreateInfo-usage-10251/10252). The capabilities are re-queried
+ * through a local chain so the codec-owned caps structs filled by
+ * ff_vulkan_encode_init() are left untouched. Returns 0 on success. */
+static int pelorus_qpmap_query_caps(FFVulkanEncodeContext *ctx,
+                                    int *min_delta, int *max_delta,
+                                    VkExtent2D *max_extent)
+{
+    VkResult ret;
+    FFVulkanContext *s = &ctx->s;
+    FFVulkanFunctions *vk = &s->vkfn;
+    const VkVideoCodecOperationFlagBitsKHR op = ctx->profile.videoCodecOperation;
+    union {
+        VkVideoEncodeH264CapabilitiesKHR h264;
+        VkVideoEncodeH265CapabilitiesKHR h265;
+#ifdef VK_KHR_video_encode_av1
+        VkVideoEncodeAV1CapabilitiesKHR  av1;
+#endif
+    } codec_caps;
+    union {
+        VkVideoEncodeH264QuantizationMapCapabilitiesKHR h264;
+        VkVideoEncodeH265QuantizationMapCapabilitiesKHR h265;
+#ifdef VK_KHR_video_encode_av1
+        VkVideoEncodeAV1QuantizationMapCapabilitiesKHR  av1;
+#endif
+    } qmap_caps;
+    VkVideoEncodeQuantizationMapCapabilitiesKHR qmap_common = {
+        .sType = VK_STRUCTURE_TYPE_VIDEO_ENCODE_QUANTIZATION_MAP_CAPABILITIES_KHR,
+        .pNext = &qmap_caps,
+    };
+    VkVideoEncodeCapabilitiesKHR enc_caps = {
+        .sType = VK_STRUCTURE_TYPE_VIDEO_ENCODE_CAPABILITIES_KHR,
+        .pNext = &qmap_common,
+    };
+    VkVideoCapabilitiesKHR caps = {
+        .sType = VK_STRUCTURE_TYPE_VIDEO_CAPABILITIES_KHR,
+        .pNext = &enc_caps,
+    };
+
+    memset(&codec_caps, 0, sizeof(codec_caps));
+    memset(&qmap_caps, 0, sizeof(qmap_caps));
+
+    /* The codec-specific caps struct is mandatory in the chain; each codec's
+     * quantization-map caps struct is valid only for that codec's profile. */
+    if (op == VK_VIDEO_CODEC_OPERATION_ENCODE_H264_BIT_KHR) {
+        codec_caps.h264.sType = VK_STRUCTURE_TYPE_VIDEO_ENCODE_H264_CAPABILITIES_KHR;
+        qmap_caps.h264.sType  = VK_STRUCTURE_TYPE_VIDEO_ENCODE_H264_QUANTIZATION_MAP_CAPABILITIES_KHR;
+        qmap_caps.h264.pNext  = &codec_caps;
+    } else if (op == VK_VIDEO_CODEC_OPERATION_ENCODE_H265_BIT_KHR) {
+        codec_caps.h265.sType = VK_STRUCTURE_TYPE_VIDEO_ENCODE_H265_CAPABILITIES_KHR;
+        qmap_caps.h265.sType  = VK_STRUCTURE_TYPE_VIDEO_ENCODE_H265_QUANTIZATION_MAP_CAPABILITIES_KHR;
+        qmap_caps.h265.pNext  = &codec_caps;
+#ifdef VK_KHR_video_encode_av1
+    } else if (op == VK_VIDEO_CODEC_OPERATION_ENCODE_AV1_BIT_KHR) {
+        codec_caps.av1.sType = VK_STRUCTURE_TYPE_VIDEO_ENCODE_AV1_CAPABILITIES_KHR;
+        qmap_caps.av1.sType  = VK_STRUCTURE_TYPE_VIDEO_ENCODE_AV1_QUANTIZATION_MAP_CAPABILITIES_KHR;
+        qmap_caps.av1.pNext  = &codec_caps;
+#endif
+    } else {
+        return AVERROR(ENOSYS);
+    }
+
+    ret = vk->GetPhysicalDeviceVideoCapabilitiesKHR(s->hwctx->phys_dev,
+                                                    &ctx->profile, &caps);
+    if (ret != VK_SUCCESS)
+        return AVERROR_EXTERNAL;
+
+    *max_extent = qmap_common.maxQuantizationMapExtent;
+    if (op == VK_VIDEO_CODEC_OPERATION_ENCODE_H264_BIT_KHR) {
+        *min_delta = qmap_caps.h264.minQpDelta;
+        *max_delta = qmap_caps.h264.maxQpDelta;
+    } else if (op == VK_VIDEO_CODEC_OPERATION_ENCODE_H265_BIT_KHR) {
+        *min_delta = qmap_caps.h265.minQpDelta;
+        *max_delta = qmap_caps.h265.maxQpDelta;
+#ifdef VK_KHR_video_encode_av1
+    } else {
+        *min_delta = qmap_caps.av1.minQIndexDelta;
+        *max_delta = qmap_caps.av1.maxQIndexDelta;
+#endif
+    }
+    return 0;
+}
+
+/* Bytes per texel of a map format the rasterizers can write: signed delta
+ * formats for a delta map, unorm formats for an emphasis map. 0 = not one. */
+static int pelorus_qpmap_texel_bytes(VkFormat format, int emphasis)
+{
+    if (emphasis) {
+        switch (format) {
+        case VK_FORMAT_R8_UNORM:  return 1;
+        case VK_FORMAT_R16_UNORM: return 2;
+        default:                  return 0;
+        }
+    }
+    switch (format) {
+    case VK_FORMAT_R8_SINT:  return 1;
+    case VK_FORMAT_R16_SINT: return 2;
+    case VK_FORMAT_R32_SINT: return 4;
+    default:                 return 0;
+    }
+}
+
+static const char *pelorus_qpmap_fill_name(int fill)
+{
+    switch (fill) {
+    case PELORUS_QPMAP_FILL_GPU:  return "on-GPU compute (pelorus_qpmap)";
+    case PELORUS_QPMAP_FILL_COPY: return "host raster + staging copy";
+    case PELORUS_QPMAP_FILL_HOST: return "host raster into a mapped linear image";
+    default:                      return "none";
+    }
+}
+
+/* The fill path that can write one advertised map entry, or FILL_NONE.
+ * `can_copy`: the encode queue family may record vkCmdCopyBufferToImage
+ * (transfer, graphics or compute; VUID-vkCmdCopyBufferToImage-commandBuffer-
+ * cmdpool). `want_gpu`: the compute rasterizer is built in and the encode queue
+ * family has compute. The shader declares 8-bit storage formats (r8i / r8), so
+ * a wider format goes to a host path. DRM-modifier tiling needs a modifier list
+ * this encoder does not build, so only OPTIMAL and LINEAR entries count. */
+static int pelorus_qpmap_entry_fill(const VkVideoFormatPropertiesKHR *p,
+                                    const VkVideoFormatQuantizationMapPropertiesKHR *q,
+                                    int emphasis, int can_copy, int want_gpu)
+{
+    if (!pelorus_qpmap_texel_bytes(p->format, emphasis) ||
+        !q->quantizationMapTexelSize.width || !q->quantizationMapTexelSize.height ||
+        (p->imageTiling != VK_IMAGE_TILING_OPTIMAL &&
+         p->imageTiling != VK_IMAGE_TILING_LINEAR))
+        return PELORUS_QPMAP_FILL_NONE;
+    if (want_gpu && (p->imageUsageFlags & VK_IMAGE_USAGE_STORAGE_BIT) &&
+        p->format == (emphasis ? VK_FORMAT_R8_UNORM : VK_FORMAT_R8_SINT))
+        return PELORUS_QPMAP_FILL_GPU;
+    if (can_copy && (p->imageUsageFlags & VK_IMAGE_USAGE_TRANSFER_DST_BIT))
+        return PELORUS_QPMAP_FILL_COPY;
+    if (p->imageTiling == VK_IMAGE_TILING_LINEAR)
+        return PELORUS_QPMAP_FILL_HOST;
+    return PELORUS_QPMAP_FILL_NONE;
+}
+
+/* One vkGetPhysicalDeviceVideoFormatPropertiesKHR round for the map image usage
+ * `usage`, with VkVideoFormatQuantizationMapPropertiesKHR (the per-texel block,
+ * commonly 16x16 to 64x64 px) chained to every entry. Returns the number of
+ * entries in *props / *qprops (caller frees both), 0 when the driver offers
+ * nothing for this usage combination (a failing VkResult is logged, so an
+ * error stays distinguishable from an empty answer), or a negative AVERROR. */
+static int pelorus_qpmap_query_formats(AVCodecContext *avctx,
+                                       FFVulkanEncodeContext *ctx,
+                                       VkImageUsageFlags usage,
+                                       VkVideoFormatPropertiesKHR **props,
+                                       VkVideoFormatQuantizationMapPropertiesKHR **qprops)
+{
+    VkResult ret;
+    FFVulkanContext *s = &ctx->s;
+    FFVulkanFunctions *vk = &s->vkfn;
+    uint32_t nb = 0;
+    VkPhysicalDeviceVideoFormatInfoKHR fmt_info = {
+        .sType      = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VIDEO_FORMAT_INFO_KHR,
+        .pNext      = &ctx->profile_list,
+        .imageUsage = usage,
+    };
+
+    *props  = NULL;
+    *qprops = NULL;
+    ret = vk->GetPhysicalDeviceVideoFormatPropertiesKHR(s->hwctx->phys_dev,
+                                                        &fmt_info, &nb, NULL);
+    if (ret != VK_SUCCESS) {
+        av_log(avctx, AV_LOG_VERBOSE, "pelorus_roi: map format query, image "
+               "usage 0x%x: %s.\n", usage, ff_vk_ret2str(ret));
+        return 0;
+    }
+    if (!nb)
+        return 0;
+
+    *props  = av_calloc(nb, sizeof(**props));
+    *qprops = av_calloc(nb, sizeof(**qprops));
+    if (!*props || !*qprops)
+        return AVERROR(ENOMEM);
+    for (uint32_t i = 0; i < nb; i++) {
+        (*qprops)[i].sType = VK_STRUCTURE_TYPE_VIDEO_FORMAT_QUANTIZATION_MAP_PROPERTIES_KHR;
+        (*props)[i].sType  = VK_STRUCTURE_TYPE_VIDEO_FORMAT_PROPERTIES_KHR;
+        (*props)[i].pNext  = &(*qprops)[i];
+    }
+
+    ret = vk->GetPhysicalDeviceVideoFormatPropertiesKHR(s->hwctx->phys_dev,
+                                                        &fmt_info, &nb, *props);
+    if (ret != VK_SUCCESS && ret != VK_INCOMPLETE) {
+        av_log(avctx, AV_LOG_VERBOSE, "pelorus_roi: map format query, image "
+               "usage 0x%x: %s.\n", usage, ff_vk_ret2str(ret));
+        return 0;
+    }
+    return nb;
+}
+
+/* Choose the map format, tiling and fill path. Drivers answer the format query
+ * with the image usages asked for (RADV returns exactly those bits; NVIDIA adds
+ * more), so the map usage alone says nothing about fillability. Ask first for
+ * the map usage plus every fill usage this encode queue family can record; if
+ * the driver offers nothing for that combination, ask for each fill usage on
+ * its own, then for the map usage alone (host-mapped fill of a LINEAR entry).
+ * The first query with a fillable entry decides: within it the best fill path
+ * wins, then the narrowest texel. Sets ctx->qpmap_{fill,format,texel_bytes,
+ * texel_size,tiling,fmt_usage}. Returns 1 on success, 0 when nothing is
+ * fillable (warned, with every advertised entry listed), or a negative
+ * AVERROR. */
+static int pelorus_qpmap_pick_format(AVCodecContext *avctx,
+                                     FFVulkanEncodeContext *ctx,
+                                     VkImageUsageFlags map_usage)
+{
+    const FFVulkanContext *s = &ctx->s;
+    /* What the encode command buffer may record is set by the queue family's
+     * own capabilities (the command-pool VUIDs), not by the purposes
+     * AVVulkanDeviceQueueFamily.flags lists FFmpeg picked it for: NVIDIA's
+     * encode family also has TRANSFER, RADV's has VIDEO_ENCODE only. */
+    const VkQueueFlags qflags = s->qf_props && ctx->qf_enc->idx < s->tot_nb_qfs ?
+        s->qf_props[ctx->qf_enc->idx].queueFamilyProperties.queueFlags :
+        ctx->qf_enc->flags;
+    const int can_copy = !!(qflags & (VK_QUEUE_TRANSFER_BIT | VK_QUEUE_GRAPHICS_BIT |
+                                      VK_QUEUE_COMPUTE_BIT));
+    int want_gpu = 0, nb_queries = 0, found = 0, nb_seen = 0;
+    VkImageUsageFlags queries[4];
+
+    /* The on-GPU raster records a compute dispatch on the encode command
+     * buffer, so it needs an encode queue family with VK_QUEUE_COMPUTE_BIT;
+     * without CONFIG_PELORUS_QPMAP_GPU the rasterizer is not compiled in. */
+#if CONFIG_PELORUS_QPMAP_GPU
+    want_gpu = !!(qflags & VK_QUEUE_COMPUTE_BIT);
+#endif
+
+    queries[nb_queries++] = map_usage |
+                            (can_copy ? VK_IMAGE_USAGE_TRANSFER_DST_BIT : 0) |
+                            (want_gpu ? VK_IMAGE_USAGE_STORAGE_BIT : 0);
+    if (can_copy && want_gpu) {
+        queries[nb_queries++] = map_usage | VK_IMAGE_USAGE_STORAGE_BIT;
+        queries[nb_queries++] = map_usage | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+    }
+    if (queries[0] != map_usage)
+        queries[nb_queries++] = map_usage;
+
+    for (int k = 0; k < nb_queries && !found; k++) {
+        VkVideoFormatPropertiesKHR *props;
+        VkVideoFormatQuantizationMapPropertiesKHR *qprops;
+        int sel = -1, sel_fill = PELORUS_QPMAP_FILL_NONE;
+        int nb = pelorus_qpmap_query_formats(avctx, ctx, queries[k], &props,
+                                             &qprops);
+
+        if (nb < 0) {
+            av_free(props);
+            av_free(qprops);
+            return nb;
+        }
+        av_log(avctx, AV_LOG_VERBOSE, "pelorus_roi: map format query, image "
+               "usage 0x%x: %d entr%s.\n", queries[k], nb, nb == 1 ? "y" : "ies");
+        for (int i = 0; i < nb; i++) {
+            int fill = pelorus_qpmap_entry_fill(&props[i], &qprops[i],
+                                                ctx->qpmap_emphasis, can_copy,
+                                                want_gpu);
+            av_log(avctx, AV_LOG_VERBOSE, "    format %d tiling %d usage 0x%x "
+                   "texel %ux%u: fill %s\n", props[i].format,
+                   props[i].imageTiling, props[i].imageUsageFlags,
+                   qprops[i].quantizationMapTexelSize.width,
+                   qprops[i].quantizationMapTexelSize.height,
+                   pelorus_qpmap_fill_name(fill));
+            if (fill > sel_fill ||
+                (fill != PELORUS_QPMAP_FILL_NONE && fill == sel_fill &&
+                 pelorus_qpmap_texel_bytes(props[i].format, ctx->qpmap_emphasis) <
+                 pelorus_qpmap_texel_bytes(props[sel].format, ctx->qpmap_emphasis))) {
+                sel      = i;
+                sel_fill = fill;
+            }
+        }
+        nb_seen += nb;
+        if (sel_fill != PELORUS_QPMAP_FILL_NONE) {
+            ctx->qpmap_fill        = sel_fill;
+            ctx->qpmap_format      = props[sel].format;
+            ctx->qpmap_texel_bytes = pelorus_qpmap_texel_bytes(props[sel].format,
+                                                               ctx->qpmap_emphasis);
+            ctx->qpmap_texel_size  = qprops[sel].quantizationMapTexelSize;
+            ctx->qpmap_tiling      = props[sel].imageTiling;
+            ctx->qpmap_fmt_usage   = props[sel].imageUsageFlags;
+            found = 1;
+        }
+        av_free(props);
+        av_free(qprops);
+    }
+
+    if (!found)
+        av_log(avctx, AV_LOG_WARNING, "pelorus_roi: none of the %d advertised "
+               "%s-map format entries is fillable on this encode queue family "
+               "(flags 0x%x: staging copy %s, compute raster %s; a LINEAR "
+               "%s entry needs no queue support); disabled. -v verbose lists "
+               "the entries.\n", nb_seen,
+               ctx->qpmap_emphasis ? "emphasis" : "delta", (unsigned)qflags,
+               can_copy ? "allowed" : "not allowed",
+               want_gpu ? "allowed" : "not allowed",
+               ctx->qpmap_emphasis ? "R8_UNORM/R16_UNORM" : "R8/R16/R32_SINT");
+    return found;
+}
+
+/* Signed range of a delta-map texel `bytes` wide. */
+static void pelorus_qpmap_texel_range(int bytes, int *lo, int *hi)
+{
+    *lo = bytes == 1 ? INT8_MIN : bytes == 2 ? INT16_MIN : INT32_MIN;
+    *hi = bytes == 1 ? INT8_MAX : bytes == 2 ? INT16_MAX : INT32_MAX;
+}
+
+/* Probe VK_KHR_video_encode_quantization_map for this profile and pick the map
+ * kind from the negotiated rate-control mode. Fills ctx->qpmap_* and leaves
+ * ctx->qpmap_enabled set on success; on any miss it warns once and leaves the
+ * path inert (pass-through). Never fails the encoder. */
+static void pelorus_qpmap_probe(AVCodecContext *avctx, FFVulkanEncodeContext *ctx)
+{
+    FFVulkanContext *s = &ctx->s;
+    VkImageUsageFlags map_usage;
+    const VkPhysicalDeviceVideoEncodeQuantizationMapFeaturesKHR *qmap_feats;
+    int delta_ok, emphasis_ok, want_emphasis, qp_range, texel_min, texel_max;
+    int cap_min, cap_max;
+    VkExtent2D max_extent;
+
+    if (!ctx->opts.pelorus_roi)
+        return;
+
+    /* The device must enable the extension AND its videoEncodeQuantizationMap
+     * feature (VUID-VkVideoSessionCreateInfoKHR-flags-10264). Stock FFmpeg
+     * enables neither; this patch adds both to hwcontext_vulkan's optional
+     * extension/feature tables, so an FFmpeg-created device turns them on
+     * whenever the driver supports them. An application-supplied device must
+     * enable both itself. The user asked for steering, so a miss warns. */
+    if (!(s->extensions & FF_VK_EXT_VIDEO_ENCODE_QUANTIZATION_MAP)) {
+        av_log(avctx, AV_LOG_WARNING, "pelorus_roi: device does not enable %s; "
+               "QP-map steering disabled (pass-through).\n",
+               VK_KHR_VIDEO_ENCODE_QUANTIZATION_MAP_EXTENSION_NAME);
+        return;
+    }
+    qmap_feats = ff_vk_find_struct(s->hwctx->device_features.pNext,
+                                   VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VIDEO_ENCODE_QUANTIZATION_MAP_FEATURES_KHR);
+    if (!qmap_feats || !qmap_feats->videoEncodeQuantizationMap) {
+        av_log(avctx, AV_LOG_WARNING, "pelorus_roi: device enables %s but not "
+               "its videoEncodeQuantizationMap feature; QP-map steering "
+               "disabled (pass-through).\n",
+               VK_KHR_VIDEO_ENCODE_QUANTIZATION_MAP_EXTENSION_NAME);
+        return;
+    }
+
+    delta_ok    = !!(ctx->enc_caps.flags &
+                     VK_VIDEO_ENCODE_CAPABILITY_QUANTIZATION_DELTA_MAP_BIT_KHR);
+    emphasis_ok = !!(ctx->enc_caps.flags &
+                     VK_VIDEO_ENCODE_CAPABILITY_EMPHASIS_MAP_BIT_KHR);
+
+    /* Emphasis maps drive CBR/VBR; delta maps drive CQP (rc disabled). */
+    want_emphasis = (ctx->opts.rc_mode == VK_VIDEO_ENCODE_RATE_CONTROL_MODE_CBR_BIT_KHR ||
+                     ctx->opts.rc_mode == VK_VIDEO_ENCODE_RATE_CONTROL_MODE_VBR_BIT_KHR);
+
+    if (want_emphasis && emphasis_ok) {
+        ctx->qpmap_emphasis = 1;
+        map_usage = VK_IMAGE_USAGE_VIDEO_ENCODE_EMPHASIS_MAP_BIT_KHR;
+    } else if (!want_emphasis && delta_ok) {
+        ctx->qpmap_emphasis = 0;
+        map_usage = VK_IMAGE_USAGE_VIDEO_ENCODE_QUANTIZATION_DELTA_MAP_BIT_KHR;
+    } else {
+        av_log(avctx, AV_LOG_WARNING, "pelorus_roi: no quantization-map mode for "
+               "the negotiated rate control (delta=%d emphasis=%d); disabled.\n",
+               delta_ok, emphasis_ok);
+        return;
+    }
+
+    /* Format, tiling and fill path. The map image is later created with
+     * exactly the chosen entry's tiling (VUID-VkImageCreateInfo-pNext-06811):
+     * drivers differ here, e.g. NVIDIA advertises its R8_SINT delta map in
+     * LINEAR tiling only, RADV its R32_SINT map in OPTIMAL and LINEAR. */
+    if (pelorus_qpmap_pick_format(avctx, ctx, map_usage) <= 0)
+        return;
+
+    ctx->qpmap_w = (avctx->width  + ctx->qpmap_texel_size.width  - 1) /
+                   ctx->qpmap_texel_size.width;
+    ctx->qpmap_h = (avctx->height + ctx->qpmap_texel_size.height - 1) /
+                   ctx->qpmap_texel_size.height;
+
+    if (pelorus_qpmap_query_caps(ctx, &cap_min, &cap_max, &max_extent) < 0) {
+        av_log(avctx, AV_LOG_WARNING, "pelorus_roi: could not query the "
+               "driver's quantization-map capabilities; disabled.\n");
+        return;
+    }
+    /* A map larger than maxQuantizationMapExtent cannot be created; refuse it
+     * instead of clamping, which would steer the wrong blocks. RADV: 256x256
+     * texels (H.264, 16x16 px), 128x68 (H.265, 64x64 px = 8192x4352). */
+    if ((uint32_t)ctx->qpmap_w > max_extent.width ||
+        (uint32_t)ctx->qpmap_h > max_extent.height) {
+        av_log(avctx, AV_LOG_WARNING, "pelorus_roi: a %dx%d px picture needs a "
+               "%dx%d-texel map, above the driver's maxQuantizationMapExtent "
+               "%ux%u; disabled.\n", avctx->width, avctx->height,
+               ctx->qpmap_w, ctx->qpmap_h, max_extent.width, max_extent.height);
+        return;
+    }
+
+    /* The qoffset -> dQP scale stays the libx264 QP span (the Tier-1 NVENC/QSV
+     * convention). An emphasis map is normalized against that span. A delta
+     * map is additionally clamped to the driver-reported per-codec delta
+     * range, which can be far narrower (NVIDIA reports [0, 51] for H.264 and
+     * H.265, i.e. no negative dQP), and to the range of the map texel format
+     * (R8_SINT, R16_SINT or R32_SINT). */
+    qp_range = pelorus_qp_range(avctx);
+    ctx->qpmap_qp_delta_min = -qp_range;
+    ctx->qpmap_qp_delta_max =  qp_range;
+    if (!ctx->qpmap_emphasis) {
+        if (cap_max <= cap_min) {
+            av_log(avctx, AV_LOG_WARNING, "pelorus_roi: driver reports an empty "
+                   "quantization delta range [%d, %d]; disabled.\n",
+                   cap_min, cap_max);
+            return;
+        }
+        pelorus_qpmap_texel_range(ctx->qpmap_texel_bytes, &texel_min, &texel_max);
+        ctx->qpmap_qp_delta_min = FFMAX(FFMAX(cap_min, -qp_range), texel_min);
+        ctx->qpmap_qp_delta_max = FFMIN(FFMIN(cap_max,  qp_range), texel_max);
+        /* Texels outside every ROI carry 0 (no change); a range that excludes
+         * 0 cannot express "no change", so steering would distort the whole
+         * frame. */
+        if (ctx->qpmap_qp_delta_min > 0 || ctx->qpmap_qp_delta_max < 0) {
+            av_log(avctx, AV_LOG_WARNING, "pelorus_roi: driver delta range [%d, %d] "
+                   "excludes 0; disabled.\n", cap_min, cap_max);
+            return;
+        }
+        if (ctx->qpmap_qp_delta_min == 0)
+            av_log(avctx, AV_LOG_WARNING, "pelorus_roi: driver delta range is "
+                   "[%d, %d]; regions asking for a lower QP (negative qoffset) "
+                   "are clamped to 0 and get no extra bits.\n", cap_min, cap_max);
+        if (ctx->qpmap_qp_delta_max == 0)
+            av_log(avctx, AV_LOG_WARNING, "pelorus_roi: driver delta range is "
+                   "[%d, %d]; regions asking for a higher QP (positive qoffset) "
+                   "are clamped to 0.\n", cap_min, cap_max);
+    }
+    ctx->qpmap_enabled = 1;
+    /* The ROI side data is now consumed: silence hw_base_encode's
+     * "ROI side data on input frames ignored" warning. */
+    ctx->base.roi_allowed = 1;
+
+    av_log(avctx, AV_LOG_VERBOSE, "Pelorus QP-map steering enabled: %s map, "
+           "format %d (%d byte%s/texel), %dx%d texels (%dx%d px/texel, %s "
+           "tiling), dQP [%d, %d], fill: %s.\n",
+           ctx->qpmap_emphasis ? "emphasis" : "delta", ctx->qpmap_format,
+           ctx->qpmap_texel_bytes, ctx->qpmap_texel_bytes == 1 ? "" : "s",
+           ctx->qpmap_w, ctx->qpmap_h,
+           ctx->qpmap_texel_size.width, ctx->qpmap_texel_size.height,
+           ctx->qpmap_tiling == VK_IMAGE_TILING_LINEAR ? "linear" : "optimal",
+           ctx->qpmap_qp_delta_min, ctx->qpmap_qp_delta_max,
+           pelorus_qpmap_fill_name(ctx->qpmap_fill));
+
+    /* The map images (one per exec context), the host raster scratch and an
+     * on-GPU fill's shader are created by pelorus_qpmap_init() once enc_pool
+     * exists, still before the video session. */
+}
+
+/* Host-mapped fill: map the slot's LINEAR image memory once and record where
+ * its texels start and how far apart its rows are. The memory stays mapped
+ * until vkFreeMemory, which unmaps it implicitly. Returns 0 or AVERROR. */
+static int pelorus_qpmap_map_host(FFVulkanEncodeContext *ctx, int slot)
+{
+    FFVulkanContext *s = &ctx->s;
+    FFVulkanFunctions *vk = &s->vkfn;
+    VkSubresourceLayout layout = { 0 };
+    void *mapped = NULL;
+
+    if (vk->MapMemory(s->hwctx->act_dev, ctx->qpmap_mem[slot], 0, VK_WHOLE_SIZE,
+                      0, &mapped) != VK_SUCCESS)
+        return AVERROR_EXTERNAL;
+    vk->GetImageSubresourceLayout(s->hwctx->act_dev, ctx->qpmap_img[slot],
+                                  &(VkImageSubresource) {
+                                      .aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+                                  }, &layout);
+    if (layout.rowPitch < (VkDeviceSize)ctx->qpmap_w * ctx->qpmap_texel_bytes)
+        return AVERROR_EXTERNAL;
+    ctx->qpmap_host[slot] = (PelorusQpMapHostSlot) {
+        .texels = (uint8_t *)mapped + layout.offset,
+        .pitch  = layout.rowPitch,
+        .layout = VK_IMAGE_LAYOUT_PREINITIALIZED,
+    };
+    return 0;
+}
+
+/* Whether `bits` (VkMemoryRequirements::memoryTypeBits) admits a memory type
+ * with all of `flags`. Checked before ff_vk_alloc_mem(), which would log a
+ * missing type as an error although the encoder carries on without steering. */
+static int pelorus_qpmap_have_mem_type(const FFVulkanContext *s, uint32_t bits,
+                                       VkMemoryPropertyFlags flags)
+{
+    for (uint32_t i = 0; i < s->mprops.memoryTypeCount; i++)
+        if ((bits & (1u << i)) &&
+            (s->mprops.memoryTypes[i].propertyFlags & flags) == flags)
+            return 1;
+    return 0;
+}
+
+/* Create the quant-map image for one exec-pool context (sized from qpmap_w/h).
+ * Called for every context by pelorus_qpmap_init(); the arrays themselves are
+ * allocated on the first call. Returns 0 on success; on failure clears
+ * qpmap_enabled (pass-through) and warns once. */
+static int pelorus_qpmap_ensure_image(AVCodecContext *avctx,
+                                      FFVulkanEncodeContext *ctx, int slot)
+{
+    VkResult ret;
+    FFVulkanContext *s = &ctx->s;
+    FFVulkanFunctions *vk = &s->vkfn;
+    VkMemoryRequirements2 mreq = { .sType = VK_STRUCTURE_TYPE_MEMORY_REQUIREMENTS_2 };
+    VkImageMemoryRequirementsInfo2 mreq_info = {
+        .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_REQUIREMENTS_INFO_2,
+    };
+    VkBindImageMemoryInfo bind_info = {
+        .sType = VK_STRUCTURE_TYPE_BIND_IMAGE_MEMORY_INFO,
+    };
+    VkImageCreateInfo img_info;
+    VkImageViewCreateInfo view_info;
+    VkImageUsageFlags usage = ctx->qpmap_emphasis ?
+        VK_IMAGE_USAGE_VIDEO_ENCODE_EMPHASIS_MAP_BIT_KHR :
+        VK_IMAGE_USAGE_VIDEO_ENCODE_QUANTIZATION_DELTA_MAP_BIT_KHR;
+    VkMemoryPropertyFlagBits mem_flags;
+    const int host = ctx->qpmap_fill == PELORUS_QPMAP_FILL_HOST;
+    const VkMemoryPropertyFlags req_flags = host ?
+        VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT :
+        VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT;
+    const char *why = "the image could not be created";
+    int err = 0;
+
+    /* Image usage = map usage + what the fill path writes with. The on-GPU
+     * raster compute-stores into the map (GENERAL layout), so it needs STORAGE;
+     * the copy path needs TRANSFER_DST; the host-mapped path writes through a
+     * memory mapping and needs no extra usage, but host-visible memory and a
+     * PREINITIALIZED start (host access to a linear image is defined only in
+     * PREINITIALIZED or GENERAL layout). Every fill records on the encode
+     * command buffer, so the image stays EXCLUSIVE to one queue family — no
+     * ownership transfer. */
+    VkImageUsageFlags fill_usage =
+        ctx->qpmap_fill == PELORUS_QPMAP_FILL_GPU  ? VK_IMAGE_USAGE_STORAGE_BIT :
+        ctx->qpmap_fill == PELORUS_QPMAP_FILL_COPY ? VK_IMAGE_USAGE_TRANSFER_DST_BIT : 0;
+
+    if (!ctx->qpmap_img) {
+        ctx->qpmap_nb_img = ctx->enc_pool.pool_size;
+        ctx->qpmap_img  = av_calloc(ctx->qpmap_nb_img, sizeof(*ctx->qpmap_img));
+        ctx->qpmap_mem  = av_calloc(ctx->qpmap_nb_img, sizeof(*ctx->qpmap_mem));
+        ctx->qpmap_view = av_calloc(ctx->qpmap_nb_img, sizeof(*ctx->qpmap_view));
+        ctx->qpmap_host = av_calloc(ctx->qpmap_nb_img, sizeof(*ctx->qpmap_host));
+        if (!ctx->qpmap_img || !ctx->qpmap_mem || !ctx->qpmap_view ||
+            !ctx->qpmap_host) {
+            err = AVERROR(ENOMEM);
+            goto fail;
+        }
+    }
+
+    if (ctx->qpmap_view[slot])
+        return 0;
+
+    img_info = (VkImageCreateInfo) {
+        .sType         = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+        .pNext         = &ctx->profile_list,
+        .imageType     = VK_IMAGE_TYPE_2D,
+        .format        = ctx->qpmap_format,
+        .extent        = { ctx->qpmap_w, ctx->qpmap_h, 1 },
+        .mipLevels     = 1,
+        .arrayLayers   = 1,
+        .samples       = VK_SAMPLE_COUNT_1_BIT,
+        .tiling        = ctx->qpmap_tiling,
+        .usage         = usage | fill_usage,
+        .sharingMode   = VK_SHARING_MODE_EXCLUSIVE,
+        .initialLayout = host ? VK_IMAGE_LAYOUT_PREINITIALIZED
+                              : VK_IMAGE_LAYOUT_UNDEFINED,
+    };
+    ret = vk->CreateImage(s->hwctx->act_dev, &img_info, s->hwctx->alloc,
+                          &ctx->qpmap_img[slot]);
+    if (ret != VK_SUCCESS) {
+        err = AVERROR_EXTERNAL;
+        goto fail;
+    }
+
+    mreq_info.image = ctx->qpmap_img[slot];
+    vk->GetImageMemoryRequirements2(s->hwctx->act_dev, &mreq_info, &mreq);
+    if (!pelorus_qpmap_have_mem_type(s, mreq.memoryRequirements.memoryTypeBits,
+                                     req_flags)) {
+        why = host ? "no host-visible coherent memory type fits the image"
+                   : "no device-local memory type fits the image";
+        err = AVERROR(ENOSYS);
+        goto fail;
+    }
+    err = ff_vk_alloc_mem(s, &mreq.memoryRequirements, req_flags, NULL,
+                          &mem_flags, &ctx->qpmap_mem[slot]);
+    if (err < 0)
+        goto fail;
+
+    bind_info.image  = ctx->qpmap_img[slot];
+    bind_info.memory = ctx->qpmap_mem[slot];
+    ret = vk->BindImageMemory2(s->hwctx->act_dev, 1, &bind_info);
+    if (ret != VK_SUCCESS) {
+        err = AVERROR_EXTERNAL;
+        goto fail;
+    }
+
+    if (host && (err = pelorus_qpmap_map_host(ctx, slot)) < 0)
+        goto fail;
+
+    view_info = (VkImageViewCreateInfo) {
+        .sType    = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO,
+        .image    = ctx->qpmap_img[slot],
+        .viewType = VK_IMAGE_VIEW_TYPE_2D,
+        .format   = ctx->qpmap_format,
+        .components = { VK_COMPONENT_SWIZZLE_IDENTITY, VK_COMPONENT_SWIZZLE_IDENTITY,
+                        VK_COMPONENT_SWIZZLE_IDENTITY, VK_COMPONENT_SWIZZLE_IDENTITY },
+        .subresourceRange = {
+            .aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+            .levelCount = 1, .layerCount = 1,
+        },
+    };
+    ret = vk->CreateImageView(s->hwctx->act_dev, &view_info, s->hwctx->alloc,
+                              &ctx->qpmap_view[slot]);
+    if (ret != VK_SUCCESS) {
+        err = AVERROR_EXTERNAL;
+        goto fail;
+    }
+
+    return 0;
+
+fail:
+    if (ctx->qpmap_img && ctx->qpmap_img[slot])
+        vk->DestroyImage(s->hwctx->act_dev, ctx->qpmap_img[slot], s->hwctx->alloc);
+    if (ctx->qpmap_mem && ctx->qpmap_mem[slot])
+        vk->FreeMemory(s->hwctx->act_dev, ctx->qpmap_mem[slot], s->hwctx->alloc);
+    if (ctx->qpmap_img)
+        ctx->qpmap_img[slot] = VK_NULL_HANDLE;
+    if (ctx->qpmap_mem)
+        ctx->qpmap_mem[slot] = VK_NULL_HANDLE;
+    if (ctx->qpmap_host)
+        ctx->qpmap_host[slot] = (PelorusQpMapHostSlot) { 0 };
+    ctx->qpmap_enabled = 0;
+    if (!ctx->qpmap_warned) {
+        ctx->qpmap_warned = 1;
+        av_log(avctx, AV_LOG_WARNING,
+               "pelorus_roi: cannot create the quantization-map image "
+               "(format %d, %s): %s; QP-map steering disabled (pass-through).\n",
+               ctx->qpmap_format, pelorus_qpmap_fill_name(ctx->qpmap_fill), why);
+    }
+    return err;
+}
+
+#if CONFIG_PELORUS_QPMAP_GPU
+/* Create a tiny 1x1 STORAGE image (+ view) in `fmt`, used only to satisfy the
+ * inactive storage-image binding of the rasterizer shader (the active map is
+ * either R8_SINT or R8_UNORM; the other binding still needs a format-matching
+ * view per the descriptor-update validity rules even though the shader's runtime
+ * branch never writes it). A plain non-video image, so MUTABLE_FORMAT and the
+ * video-encode usage constraints never apply. Built once per encoder. */
+static int pelorus_qpmap_placeholder(AVCodecContext *avctx,
+                                     FFVulkanEncodeContext *ctx, VkFormat fmt)
+{
+    VkResult ret;
+    FFVulkanContext *s = &ctx->s;
+    FFVulkanFunctions *vk = &s->vkfn;
+    VkMemoryRequirements2 mreq = { .sType = VK_STRUCTURE_TYPE_MEMORY_REQUIREMENTS_2 };
+    VkImageMemoryRequirementsInfo2 mreq_info = {
+        .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_REQUIREMENTS_INFO_2,
+    };
+    VkBindImageMemoryInfo bind_info = {
+        .sType = VK_STRUCTURE_TYPE_BIND_IMAGE_MEMORY_INFO,
+    };
+    VkMemoryPropertyFlagBits mem_flags;
+    int err;
+    VkImageCreateInfo img_info = {
+        .sType         = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+        .imageType     = VK_IMAGE_TYPE_2D,
+        .format        = fmt,
+        .extent        = { 1, 1, 1 },
+        .mipLevels     = 1,
+        .arrayLayers   = 1,
+        .samples       = VK_SAMPLE_COUNT_1_BIT,
+        .tiling        = VK_IMAGE_TILING_OPTIMAL,
+        .usage         = VK_IMAGE_USAGE_STORAGE_BIT,
+        .sharingMode   = VK_SHARING_MODE_EXCLUSIVE,
+        .initialLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+    };
+    VkImageViewCreateInfo view_info;
+
+    ret = vk->CreateImage(s->hwctx->act_dev, &img_info, s->hwctx->alloc,
+                          &ctx->qpmap_ph_img);
+    if (ret != VK_SUCCESS)
+        return AVERROR_EXTERNAL;
+    mreq_info.image = ctx->qpmap_ph_img;
+    vk->GetImageMemoryRequirements2(s->hwctx->act_dev, &mreq_info, &mreq);
+    err = ff_vk_alloc_mem(s, &mreq.memoryRequirements,
+                          VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT, NULL,
+                          &mem_flags, &ctx->qpmap_ph_mem);
+    if (err < 0)
+        return err;
+    bind_info.image  = ctx->qpmap_ph_img;
+    bind_info.memory = ctx->qpmap_ph_mem;
+    ret = vk->BindImageMemory2(s->hwctx->act_dev, 1, &bind_info);
+    if (ret != VK_SUCCESS)
+        return AVERROR_EXTERNAL;
+    view_info = (VkImageViewCreateInfo) {
+        .sType    = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO,
+        .image    = ctx->qpmap_ph_img,
+        .viewType = VK_IMAGE_VIEW_TYPE_2D,
+        .format   = fmt,
+        .subresourceRange = {
+            .aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+            .levelCount = 1, .layerCount = 1,
+        },
+    };
+    ret = vk->CreateImageView(s->hwctx->act_dev, &view_info, s->hwctx->alloc,
+                              &ctx->qpmap_ph_view);
+    if (ret != VK_SUCCESS)
+        return AVERROR_EXTERNAL;
+    return 0;
+}
+#endif /* CONFIG_PELORUS_QPMAP_GPU */
+
+/* Coalesce this frame's AV_FRAME_DATA_REGIONS_OF_INTEREST into the compact,
+ * texel-block-aligned rectangle list both raster paths consume. Mirrors the
+ * NVENC/QSV rasterizers' conversion: regions are emitted in source order (the
+ * shader / host painter scans in REVERSE so the first region still wins on
+ * overlap); each qoffset is scaled by the QP range and clamped to the codec's
+ * advertised dQP window once, here, so neither raster path bakes in codec
+ * policy. Writes up to `max` rects into `out`, sets *nb_out, and returns 1 if a
+ * map should be built (>=1 rect), 0 if the frame has no usable ROI (caller binds
+ * no map: pass-through). */
+static int pelorus_qpmap_build_rects(AVCodecContext *avctx,
+                                     FFVulkanEncodeContext *ctx,
+                                     const AVFrame *frame,
+                                     PelorusQpRect *out, int max, int *nb_out)
+{
+    AVFrameSideData *sd;
+    const AVRegionOfInterest *roi;
+    uint32_t roi_size;
+    int nb_rois, qp_range, n = 0;
+    int mapw = ctx->qpmap_w, maph = ctx->qpmap_h;
+    int blkw = ctx->qpmap_texel_size.width, blkh = ctx->qpmap_texel_size.height;
+
+    *nb_out = 0;
+
+    sd = av_frame_get_side_data(frame, AV_FRAME_DATA_REGIONS_OF_INTEREST);
+    if (!sd)
+        return 0;
+
+    roi = (const AVRegionOfInterest *)sd->data;
+    roi_size = roi->self_size;
+    if (!roi_size || sd->size % roi_size != 0) {
+        av_log(avctx, AV_LOG_ERROR, "Invalid AVRegionOfInterest.self_size.\n");
+        return 0;
+    }
+    nb_rois = sd->size / roi_size;
+    qp_range = pelorus_qp_range(avctx);
+
+    for (int i = 0; i < nb_rois && n < max; i++) {
+        int startx, endx, starty, endy, delta;
+        float qoffset;
+
+        roi = (const AVRegionOfInterest *)(sd->data + roi_size * i);
+        if (roi->qoffset.den == 0)
+            continue;
+
+        starty = av_clip(roi->top                 / blkh, 0, maph);
+        endy   = av_clip((roi->bottom + blkh - 1) / blkh, 0, maph);
+        startx = av_clip(roi->left                / blkw, 0, mapw);
+        endx   = av_clip((roi->right  + blkw - 1) / blkw, 0, mapw);
+        if (endx <= startx || endy <= starty)
+            continue;
+
+        qoffset = roi->qoffset.num * 1.0f / roi->qoffset.den;
+        delta = av_clip(lrintf(av_clipf(qoffset * qp_range,
+                                        ctx->qpmap_qp_delta_min,
+                                        ctx->qpmap_qp_delta_max)),
+                        ctx->qpmap_qp_delta_min, ctx->qpmap_qp_delta_max);
+        av_log(avctx, AV_LOG_DEBUG, "pelorus_roi: texels (%d,%d)-(%d,%d) "
+               "qoffset %.3f -> delta %d (span %d, clamp [%d, %d])\n",
+               startx, starty, endx, endy, qoffset, delta, qp_range,
+               ctx->qpmap_qp_delta_min, ctx->qpmap_qp_delta_max);
+
+        out[n++] = (PelorusQpRect) {
+            .x0 = startx, .y0 = starty, .x1 = endx, .y1 = endy, .delta = delta,
+        };
+    }
+
+    *nb_out = n;
+    return n > 0;
+}
+
+#if CONFIG_PELORUS_QPMAP_GPU
+/* Build (lazily) the quant-map rasterizer compute shader. The GLSL lives in
+ * libavcodec/vulkan/pelorus_qpmap.comp.glsl and is compiled to SPIR-V at build
+ * time: one invocation per map texel reverse-scans the ROI rect SSBO and
+ * imageStores the winning delta (R8_SINT) or emphasis (R8_UNORM). Registered
+ * against the encode exec pool so the dispatch records on the encode command
+ * buffer. On any failure it returns < 0 and the caller falls back to a host
+ * fill path (pelorus_qpmap_init_gpu).
+ *
+ * The descriptor-set binding order below MUST match the declaration order in
+ * pelorus_qpmap.comp.glsl exactly; with precompiled SPIR-V a mismatch is silent
+ * corruption, not a compile error. */
+static int pelorus_qpmap_build_shader(AVCodecContext *avctx,
+                                      FFVulkanEncodeContext *ctx)
+{
+    int err;
+    FFVulkanContext *s = &ctx->s;
+    FFVulkanShader *shd = &ctx->qpmap_shd;
+
+    /* Workgroup 16x16x1, matching the ceil(w/16) x ceil(h/16) dispatch below.
+     * No specialization constants: the rasterizer has no C-unrolled loops. */
+    ff_vk_shader_load(shd, VK_SHADER_STAGE_COMPUTE_BIT, NULL,
+                      (uint32_t []) { 16, 16, 1 }, 0);
+
+    ff_vk_shader_add_push_const(shd, 0, 6 * sizeof(int),
+                                VK_SHADER_STAGE_COMPUTE_BIT);
+
+    {
+        FFVulkanDescriptorSetBinding desc[] = {
+            {
+                .name        = "deltaImg",
+                .type        = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE,
+                .mem_layout  = "r8i",
+                .mem_quali   = "writeonly",
+                .dimensions  = 2,
+                .elems       = 0,
+                .stages      = VK_SHADER_STAGE_COMPUTE_BIT,
+            },
+            {
+                .name        = "emphImg",
+                .type        = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE,
+                .mem_layout  = "r8",
+                .mem_quali   = "writeonly",
+                .dimensions  = 2,
+                .elems       = 0,
+                .stages      = VK_SHADER_STAGE_COMPUTE_BIT,
+            },
+            {
+                .name        = "RoiBuf",
+                .type        = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER,
+                .mem_layout  = "std430",
+                .mem_quali   = "readonly",
+                .stages      = VK_SHADER_STAGE_COMPUTE_BIT,
+                .buf_content = "QpRect rects[];",
+            },
+        };
+        ff_vk_shader_add_descriptor_set(s, shd, desc, 3, 0);
+    }
+
+    err = ff_vk_shader_link(s, shd, ff_pelorus_qpmap_comp_spv_data,
+                            ff_pelorus_qpmap_comp_spv_len, "main");
+    if (err < 0)
+        goto fail;
+    err = ff_vk_shader_register_exec(s, &ctx->enc_pool, shd);
+    if (err < 0)
+        goto fail;
+
+    ctx->qpmap_shader_ready = 1;
+    return 0;
+
+fail:
+    /* Release whatever ff_vk_shader_link managed to create (descriptor-set
+     * layouts, pipeline layout). qpmap_shader_ready stays 0, so uninit will not
+     * double-free. */
+    ff_vk_shader_free(s, shd);
+    av_log(avctx, AV_LOG_VERBOSE, "pelorus_roi: could not build the on-GPU "
+           "rasterizer.\n");
+    return err;
+}
+
+/* GPU-raster bring-up: build the rasterizer shader (registered against the now-
+ * initialized enc_pool) and the inactive-binding placeholder image. On any
+ * failure fall back to a host fill path the chosen entry allows: the staging
+ * copy if it advertises TRANSFER_DST (an encode family with compute may record
+ * the copy), else the host-mapped fill for a LINEAR entry, else disable.
+ * Called once, after ff_vk_exec_pool_init. */
+static int pelorus_qpmap_init_gpu(AVCodecContext *avctx,
+                                  FFVulkanEncodeContext *ctx)
+{
+    VkFormat ph_fmt = ctx->qpmap_emphasis ? VK_FORMAT_R8_SINT
+                                          : VK_FORMAT_R8_UNORM;
+    if (pelorus_qpmap_build_shader(avctx, ctx) < 0 ||
+        pelorus_qpmap_placeholder(avctx, ctx, ph_fmt) < 0) {
+        /* Invariant: FILL_GPU was only chosen with VK_QUEUE_COMPUTE_BIT on the
+         * encode queue family (want_gpu), and compute implies can_copy, so the
+         * family may record vkCmdCopyBufferToImage; the entry's TRANSFER_DST
+         * usage is the only remaining condition of the copy fill. */
+        if (ctx->qpmap_fmt_usage & VK_IMAGE_USAGE_TRANSFER_DST_BIT) {
+            ctx->qpmap_fill = PELORUS_QPMAP_FILL_COPY;
+        } else if (ctx->qpmap_tiling == VK_IMAGE_TILING_LINEAR) {
+            ctx->qpmap_fill = PELORUS_QPMAP_FILL_HOST;
+        } else {
+            ctx->qpmap_fill    = PELORUS_QPMAP_FILL_NONE;
+            ctx->qpmap_enabled = 0;
+            av_log(avctx, AV_LOG_WARNING, "pelorus_roi: on-GPU raster setup "
+                   "failed and the map entry allows no host fill (no "
+                   "TRANSFER_DST usage, not LINEAR); disabled.\n");
+            return 0;
+        }
+        av_log(avctx, AV_LOG_VERBOSE, "pelorus_roi: on-GPU raster setup failed; "
+               "falling back.\n");
+    }
+    av_log(avctx, AV_LOG_VERBOSE, "Pelorus QP-map raster: %s.\n",
+           pelorus_qpmap_fill_name(ctx->qpmap_fill));
+    return 0;
+}
+
+/* Record the on-GPU raster: upload the compact ROI rect list into a pooled SSBO,
+ * dispatch the compute shader to write the map (GENERAL layout), then barrier it
+ * to VK_IMAGE_LAYOUT_VIDEO_ENCODE_QUANTIZATION_MAP_KHR ready for the encode. The
+ * dispatch shares exec->buf (the encode command buffer) with the encode itself,
+ * so no cross-queue sync is needed; the SSBO is kept alive as an exec dep.
+ * Returns 0 on success. */
+static int pelorus_qpmap_dispatch(AVCodecContext *avctx, FFVulkanEncodeContext *ctx,
+                                  FFVkExecContext *exec, int slot,
+                                  const PelorusQpRect *rects, int nb_rects)
+{
+    int err;
+    FFVulkanContext *s = &ctx->s;
+    FFVulkanFunctions *vk = &s->vkfn;
+    FFVulkanShader *shd = &ctx->qpmap_shd;
+    AVBufferRef *roi_ref = NULL;
+    FFVkBuffer *roi_buf;
+    size_t roi_bytes = (size_t)nb_rects * sizeof(PelorusQpRect);
+    struct {
+        int32_t width, height, nb_rects, emphasis, qp_delta_min, qp_delta_max;
+    } pc;
+
+    err = ff_vk_get_pooled_buffer(s, &ctx->qpmap_roi_pool, &roi_ref,
+                                  VK_BUFFER_USAGE_STORAGE_BUFFER_BIT, NULL,
+                                  roi_bytes,
+                                  VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+                                  VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
+    if (err < 0)
+        return err;
+    roi_buf = (FFVkBuffer *)roi_ref->data;
+    memcpy(roi_buf->mapped_mem, rects, roi_bytes);
+
+    err = ff_vk_exec_add_dep_buf(s, exec, &roi_ref, 1, 0);
+    if (err < 0) {
+        av_buffer_unref(&roi_ref);
+        return err;
+    }
+
+    /* UNDEFINED -> GENERAL for the compute store. */
+    vk->CmdPipelineBarrier2(exec->buf, &(VkDependencyInfo) {
+        .sType = VK_STRUCTURE_TYPE_DEPENDENCY_INFO,
+        .imageMemoryBarrierCount = 1,
+        .pImageMemoryBarriers = &(VkImageMemoryBarrier2) {
+            .sType         = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER_2,
+            .srcStageMask  = VK_PIPELINE_STAGE_2_NONE,
+            .dstStageMask  = VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT,
+            .dstAccessMask = VK_ACCESS_2_SHADER_STORAGE_WRITE_BIT,
+            .oldLayout     = VK_IMAGE_LAYOUT_UNDEFINED,
+            .newLayout     = VK_IMAGE_LAYOUT_GENERAL,
+            .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+            .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+            .image = ctx->qpmap_img[slot],
+            .subresourceRange = { .aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+                                  .levelCount = 1, .layerCount = 1 },
+        },
+    });
+
+    /* Binding 0 is the R8_SINT (delta) image, binding 1 the R8_UNORM (emphasis)
+     * image. The active map view goes to its matching binding; the other binding
+     * gets the format-matching 1x1 placeholder (never written by the shader's
+     * runtime branch, but a storage-image descriptor must carry a view whose
+     * format matches the binding's qualifier). */
+    if (ctx->qpmap_emphasis) {
+        ff_vk_shader_update_img(s, exec, shd, 0, 0, 0, ctx->qpmap_ph_view,
+                                VK_IMAGE_LAYOUT_GENERAL, VK_NULL_HANDLE);
+        ff_vk_shader_update_img(s, exec, shd, 0, 1, 0, ctx->qpmap_view[slot],
+                                VK_IMAGE_LAYOUT_GENERAL, VK_NULL_HANDLE);
+    } else {
+        ff_vk_shader_update_img(s, exec, shd, 0, 0, 0, ctx->qpmap_view[slot],
+                                VK_IMAGE_LAYOUT_GENERAL, VK_NULL_HANDLE);
+        ff_vk_shader_update_img(s, exec, shd, 0, 1, 0, ctx->qpmap_ph_view,
+                                VK_IMAGE_LAYOUT_GENERAL, VK_NULL_HANDLE);
+    }
+    err = ff_vk_shader_update_desc_buffer(s, exec, shd, 0, 2, 0,
+                                          roi_buf, 0, roi_bytes,
+                                          VK_FORMAT_UNDEFINED);
+    if (err < 0)
+        return err;
+
+    pc.width        = ctx->qpmap_w;
+    pc.height       = ctx->qpmap_h;
+    pc.nb_rects     = nb_rects;
+    pc.emphasis     = ctx->qpmap_emphasis;
+    pc.qp_delta_min = ctx->qpmap_qp_delta_min;
+    pc.qp_delta_max = ctx->qpmap_qp_delta_max;
+
+    ff_vk_exec_bind_shader(s, exec, shd);
+    ff_vk_shader_update_push_const(s, exec, shd, VK_SHADER_STAGE_COMPUTE_BIT,
+                                   0, sizeof(pc), &pc);
+
+    vk->CmdDispatch(exec->buf,
+                    (ctx->qpmap_w + 15) / 16, (ctx->qpmap_h + 15) / 16, 1);
+
+    /* GENERAL -> VIDEO_ENCODE_QUANTIZATION_MAP_KHR for the encode read. */
+    vk->CmdPipelineBarrier2(exec->buf, &(VkDependencyInfo) {
+        .sType = VK_STRUCTURE_TYPE_DEPENDENCY_INFO,
+        .imageMemoryBarrierCount = 1,
+        .pImageMemoryBarriers = &(VkImageMemoryBarrier2) {
+            .sType         = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER_2,
+            .srcStageMask  = VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT,
+            .srcAccessMask = VK_ACCESS_2_SHADER_STORAGE_WRITE_BIT,
+            .dstStageMask  = VK_PIPELINE_STAGE_2_VIDEO_ENCODE_BIT_KHR,
+            .dstAccessMask = VK_ACCESS_2_VIDEO_ENCODE_READ_BIT_KHR,
+            .oldLayout     = VK_IMAGE_LAYOUT_GENERAL,
+            .newLayout     = VK_IMAGE_LAYOUT_VIDEO_ENCODE_QUANTIZATION_MAP_KHR,
+            .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+            .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+            .image = ctx->qpmap_img[slot],
+            .subresourceRange = { .aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+                                  .levelCount = 1, .layerCount = 1 },
+        },
+    });
+
+    return 0;
+}
+#endif /* CONFIG_PELORUS_QPMAP_GPU */
+
+/* Store one map texel `bytes` wide in host byte order: the low bytes of the
+ * two's-complement value for a signed delta format, the code value for a
+ * unorm emphasis format. */
+static void pelorus_qpmap_store_texel(uint8_t *dst, int bytes, int32_t v)
+{
+    if (bytes == 1) {
+        dst[0] = (uint8_t)v;
+    } else if (bytes == 2) {
+        uint16_t u = (uint16_t)v;
+        memcpy(dst, &u, sizeof(u));
+    } else {
+        memcpy(dst, &v, sizeof(v));
+    }
+}
+
+/* Host raster shared by the copy and host-mapped fills: paint the ROI rect
+ * list into the per-texel scratch (one int32 dQP per texel), then store it in
+ * the probed map format as qpmap_h rows of qpmap_w texels, `pitch` bytes apart.
+ * Reverse scan so the first rect wins on overlap (lockstep with the shader and
+ * the libx265/NVENC/QSV rasterizers). A delta map stores the signed dQP
+ * verbatim; an emphasis map converts it to a unorm code value where a request
+ * for *lower* QP (negative dQP, "spend more bits") becomes a *higher*
+ * emphasis. Uses the SAME rect list and dQP convention as the GPU path. */
+static void pelorus_qpmap_raster(FFVulkanEncodeContext *ctx,
+                                 const PelorusQpRect *rects, int nb_rects,
+                                 uint8_t *dst, size_t pitch)
+{
+    const int mapw = ctx->qpmap_w, maph = ctx->qpmap_h;
+    const int bytes = ctx->qpmap_texel_bytes;
+    const int code_max = bytes == 1 ? UINT8_MAX : UINT16_MAX;
+    int range = ctx->qpmap_qp_delta_max - ctx->qpmap_qp_delta_min;
+
+    if (range <= 0)
+        range = 1;
+
+    memset(ctx->qpmap_scratch, 0,
+           ctx->qpmap_scratch_size * sizeof(*ctx->qpmap_scratch));
+    for (int i = nb_rects - 1; i >= 0; i--) {
+        const PelorusQpRect *r = &rects[i];
+        for (int y = r->y0; y < r->y1; y++)
+            for (int x = r->x0; x < r->x1; x++)
+                ctx->qpmap_scratch[x + y * mapw] = r->delta;
+    }
+
+    for (int y = 0; y < maph; y++) {
+        uint8_t *row = dst + (size_t)y * pitch;
+        for (int x = 0; x < mapw; x++) {
+            int32_t v = ctx->qpmap_scratch[x + y * mapw];
+            if (ctx->qpmap_emphasis) {
+                float emph = (float)(-v - ctx->qpmap_qp_delta_min) / (float)range;
+                v = av_clip(lrintf(emph * code_max), 0, code_max);
+            }
+            pelorus_qpmap_store_texel(row + (size_t)x * bytes, bytes, v);
+        }
+    }
+}
+
+/* Host-mapped fill (PELORUS_QPMAP_FILL_HOST), for an encode queue family that
+ * can record neither a copy nor a dispatch (RADV's has VIDEO_ENCODE only): the
+ * host rasterizes straight into this context's persistently mapped LINEAR map
+ * image, then one barrier on the encode command buffer moves it from the
+ * host-writable layout to VK_IMAGE_LAYOUT_VIDEO_ENCODE_QUANTIZATION_MAP_KHR.
+ * ff_vk_exec_start() has already waited for this context's previous
+ * submission, the last one that read the image, so the host write cannot race
+ * the encoder; the queue submission makes the host write visible to the
+ * device. HOST and VIDEO_ENCODE are the only stages involved, both valid on a
+ * video-encode-only queue. pelorus_qpmap_host_release() returns the image to
+ * GENERAL after the encode. */
+static void pelorus_qpmap_host_fill(FFVulkanEncodeContext *ctx,
+                                    FFVkExecContext *exec, int slot,
+                                    const PelorusQpRect *rects, int nb_rects)
+{
+    FFVulkanFunctions *vk = &ctx->s.vkfn;
+    PelorusQpMapHostSlot *hs = &ctx->qpmap_host[slot];
+
+    pelorus_qpmap_raster(ctx, rects, nb_rects, hs->texels, hs->pitch);
+
+    vk->CmdPipelineBarrier2(exec->buf, &(VkDependencyInfo) {
+        .sType = VK_STRUCTURE_TYPE_DEPENDENCY_INFO,
+        .imageMemoryBarrierCount = 1,
+        .pImageMemoryBarriers = &(VkImageMemoryBarrier2) {
+            .sType         = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER_2,
+            .srcStageMask  = VK_PIPELINE_STAGE_2_HOST_BIT,
+            .srcAccessMask = VK_ACCESS_2_HOST_WRITE_BIT,
