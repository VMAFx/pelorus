diff --git a/libavcodec/qsvenc.c b/libavcodec/qsvenc.c
index 6124fd72a5..a7e1a5521b 100644
--- a/libavcodec/qsvenc.c
+++ b/libavcodec/qsvenc.c
@@ -1956,6 +1956,56 @@ int ff_qsv_enc_init(AVCodecContext *avctx, QSVEncContext *q)
     return 0;
 }
 
+/**
+ * Append one SEI user-data-unregistered payload (type 5) per
+ * AV_FRAME_DATA_SEI_UNREGISTERED side-data entry of the frame to enc_ctrl, in
+ * the slots the stock A/53 callback left free. The payload buffer carries the
+ * SEI message header (type, size) in front of the UUID and data, like the A/53
+ * payload in qsvenc_h264.c. Freed with the other payloads in free_encoder_ctrl.
+ */
+static int qsvenc_add_udu_payloads(AVCodecContext *avctx, QSVEncContext *q,
+                                   const AVFrame *frame, mfxEncodeCtrl *enc_ctrl)
+{
+    for (int i = 0; i < frame->nb_side_data; i++) {
+        const AVFrameSideData *sd = frame->side_data[i];
+        size_t hdr = 2 + sd->size / 255;
+        mfxPayload *payload;
+        mfxU8 *data;
+        size_t size;
+
+        if (sd->type != AV_FRAME_DATA_SEI_UNREGISTERED || sd->size < 16)
+            continue;
+        if (enc_ctrl->NumPayload >= QSV_MAX_ENC_PAYLOAD) {
+            if (!q->udu_sei_warned) {
+                q->udu_sei_warned = 1;
+                av_log(avctx, AV_LOG_WARNING, "udu_sei: only %d SEI payloads fit "
+                       "per frame; further side data is not written.\n",
+                       QSV_MAX_ENC_PAYLOAD);
+            }
+            break;
+        }
+        /* NumBit is an mfxU32: payload size in bits must not overflow it. */
+        if (sd->size > UINT32_MAX / 8 - 16)
+            return AVERROR(EINVAL);
+        size = hdr + sd->size;
+        payload = av_mallocz(sizeof(*payload) + size);
+        if (!payload)
+            return AVERROR(ENOMEM);
+        data    = (mfxU8 *)(payload + 1);
+        data[0] = 5;                       /* user_data_unregistered */
+        memset(data + 1, 0xFF, sd->size / 255);
+        data[1 + sd->size / 255] = sd->size % 255;
+        memcpy(data + hdr, sd->data, sd->size);
+
+        payload->BufSize = size;
+        payload->NumBit  = size * 8;
+        payload->Type    = 5;
+        payload->Data    = data;
+        enc_ctrl->Payload[enc_ctrl->NumPayload++] = payload;
+    }
+    return 0;
+}
+
 static void free_encoder_ctrl(mfxEncodeCtrl* enc_ctrl)
 {
     if (enc_ctrl) {
@@ -2821,6 +2871,12 @@ static int encode_frame(AVCodecContext *avctx, QSVEncContext *q,
          enc_ctrl && QSV_RUNTIME_VERSION_ATLEAST(q->ver, 1, 13))
         set_skip_frame_encode_ctrl(avctx, frame, enc_ctrl);
 
+    if (q->udu_sei && enc_ctrl && frame) {
+        ret = qsvenc_add_udu_payloads(avctx, q, frame, enc_ctrl);
+        if (ret < 0)
+            goto free;
+    }
+
     pkt.sync = av_mallocz(sizeof(*pkt.sync));
     if (!pkt.sync)
         goto nomem;
