+def literal_argv_env() -> dict[str, str]:
+    """Return a child environment that keeps revision syntax arguments literal.
+
+    An MSYS2 or Cygwin ``git`` started from a native Windows process
+    glob-expands its command line, brace groups included, so ``n1.2.3^{commit}``
+    arrives as ``n1.2.3^commit``. ``noglob`` disables that runtime expansion;
+    every other platform and git build ignores these variables.
+    """
+    env = dict(os.environ)
+    for key in ("MSYS", "CYGWIN"):
+        env[key] = f"{env.get(key, '')} noglob".strip()
+    return env
+
