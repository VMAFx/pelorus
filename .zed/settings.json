{
  "buffer_font_size": 14,
  "format_on_save": "on",
  "hard_tabs": false,
  "languages": {
    "C": {
      "preferred_line_length": 100,
      "tab_size": 4
    },
    "C++": {
      "preferred_line_length": 100,
      "tab_size": 4
    },
    "Go": {
      "hard_tabs": true,
      "tab_size": 4
    },
    "Python": {
      "tab_size": 4
    }
  },
  "lsp": {
    "clangd": {
      "binary": {
        "path_lookup": true
      }
    }
  },
  "preferred_line_length": 120,
  "tab_size": 4
}
