# The generated FFmpeg patches are byte-exact artifacts: `git am` parses them and
# a CRLF/LF rewrite silently corrupts context lines and breaks the apply. Force
# LF and never let a filter or an autocrlf setting touch them.
*.patch    text eol=lf
*.diff     text eol=lf

# Shader sources are compiled by glslc during the FFmpeg build; keep them LF too.
*.comp     text eol=lf
*.glsl     text eol=lf

# Shell scripts must stay LF or they will not execute.
*.sh       text eol=lf

# praetorctl audit checks the dev container bundle's companions against recorded
# hashes as raw bytes; a CRLF checkout fails it (Praetor issue 313).
.devcontainer/** text eol=lf

# BEGIN praetor managed attributes (praetorctl adopt)
# praetorctl audit hashes these files; keep their checkout bytes the same on every platform.
tools/figures/** text eol=lf
docs/figures/*.ts text eol=lf
docs/assets/figures/* text eol=lf
tools/figures/third_party/interfig/upstream/** -text
# END praetor managed attributes
