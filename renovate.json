{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>plurano/horistes"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the FFmpeg release tag and peeled commit together",
      "managerFilePatterns": [
        "/^build-config\\.env$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\nFFMPEG_REMOTE=https://github\\.com/FFmpeg/FFmpeg\\.git\\nFFMPEG_TAG=(?<currentValue>n\\d+\\.\\d+\\.\\d+)\\nFFMPEG_COMMIT=(?<currentDigest>[0-9a-f]{40})"
      ],
      "versioningTemplate": "regex:^n(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Bump the Go toolchain in build-config.env",
      "managerFilePatterns": [
        "/^build-config\\.env$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\nGO_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "golang-version",
      "depNameTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "Bump the actionlint release that ci.yml's docs job runs through go run (the github-actions manager cannot see a go run line)",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": [
        "go run github\\.com/rhysd/actionlint/cmd/actionlint@(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "github.com/rhysd/actionlint",
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "Bump the gitleaks release that scripts/check-gitleaks.sh installs; GITLEAKS_SHA256 is updated by hand from the release checksums, and --install fails until it matches (ADR-0190)",
      "managerFilePatterns": [
        "/^scripts/check-gitleaks\\.sh$/"
      ],
      "matchStrings": [
        "GITLEAKS_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)\\n"
      ],
      "depNameTemplate": "gitleaks/gitleaks",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "currentValueTemplate": "HEAD",
      "customType": "regex",
      "datasourceTemplate": "git-refs",
      "depNameTemplate": "praetor-workflow-engine-pin",
      "description": "praetor workflow engine commit pin: track the engine default branch",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?m)^[\\t ]*(PRAETOR_COMMIT)[\\t ]*[:=][\\t ]*[\"']?(?<currentDigest>[0-9a-f]{40})[\"']?[\\t ]*(#[^\\r\\n]*)?\\r?$",
        "(?m)^[\\t ]*(PRAETOR_REF)[\\t ]*[:=][\\t ]*[\"']?(?<currentDigest>[0-9a-fA-F]{7,40})[\"']?[\\t ]*(#[^\\r\\n]*)?\\r?$"
      ],
      "packageNameTemplate": "https://github.com/cordanaLLM/praetor"
    }
  ],
  "packageRules": [
    {
      "description": "Keep the FFmpeg release immutable",
      "matchDatasources": [
        "github-tags"
      ],
      "matchPackageNames": [
        "FFmpeg/FFmpeg"
      ],
      "pinDigests": true
    },
    {
      "description": "Ruff and zizmor (ADR-0243): one pull request bumps both pins in the hashed lock",
      "matchFileNames": [
        ".config/python-lint/requirements.txt"
      ],
      "matchPackageNames": [
        "ruff",
        "zizmor"
      ],
      "groupName": "python lint tools"
    },
    {
      "description": "praetor-managed files: praetorctl adopt ships their updates and praetorctl audit locks them byte for byte",
      "matchFileNames": [
        ".github/workflows/praetor-docs.yml",
        "tools/markdownlint/package.json",
        "tools/markdownlint/package-lock.json",
        "tools/markdownlint/markdownlint-cli2.yaml",
        "tools/markdownlint/verify.mjs",
        "tools/markdownlint/no-private-scratch-links.mjs",
        "tools/figures/core.mjs",
        "tools/figures/checks.mjs",
        "tools/figures/build.mjs",
        "tools/figures/types.ts",
        "tools/figures/third_party/interfig/vendor.json",
        "tools/figures/third_party/interfig/VENDOR.md",
        "tools/figures/third_party/interfig/upstream/LICENSE",
        "tools/figures/third_party/interfig/upstream/src/svg.ts",
        "tools/figures/third_party/interfig/upstream/src/geometry.ts",
        "tools/figures/third_party/interfig/upstream/src/model.ts",
        "tools/figures/figures.css",
        "tools/figures/mkdocs_hook.py",
        "tools/figures/astro.mjs",
        "tools/figures/serve.mjs",
        "tools/figures/eslint.figures.mjs",
        "tools/figures/README.md",
        ".devcontainer/devcontainer.json",
        ".devcontainer/Dockerfile.praetor"
      ],
      "enabled": false
    },
    {
      "description": "praetor-managed engine: updates arrive in one coordinated adoption pull request",
      "matchPackageNames": [
        "github.com/cordanaLLM/praetor",
        "github.com/cordanaLLM/praetor/**",
        "github.com/cordanaLLM/praetor/cmd/standardsctl",
        "cordanaLLM/praetor",
        "cordanaLLM/praetor/**"
      ],
      "enabled": false
    }
  ]
}
