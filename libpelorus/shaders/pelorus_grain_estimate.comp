/*
 * pelorus_grain_estimate.comp — film-grain parameter estimator (reference).
 *
 * Copyright 2026 Lusoris
 * SPDX-License-Identifier: EUPL-1.2
 *
 * Measures the film-grain characteristics of a luma plane so a downstream
 * encoder / bitstream filter can RE-SYNTHESIZE the grain (AV1 AOM film_grain
 * OBU / H.274 FGC SEI) instead of spending bitrate coding it as residual.
 * Pass-through: the frame is unchanged; only an estimate is reduced into an
 * SSBO and read back (ADR-0115). The shader FFmpeg actually executes is
 * ffmpeg-patches/files/vulkan/pelorus_grain_estimate.comp.glsl, compiled to
 * SPIR-V at build time (ADR-0143). This file is a standalone reference kept for
 * the fast gate -- NOT a second implementation to hand-synchronise.
 *
 * Method (per intensity band, the AV1/H.274 scaling function is intensity-
 * dependent by design):
 *   1. high-pass:   resid = luma - mean3x3   (box low-pass removes structure)
 *   2. edge gate:   skip pixels whose 3x3 range is large (that residual is an
 *                   edge / texture, not grain) — estimate only on flat fields;
 *                   a chain of wider gates (2 and 4 x edge_thr) and the band
 *                   pixel total let the host recover heavy grain (ADR-0229,
 *                   ADR-0230)
 *   3. bin:         accumulate resid^2 into one of PEL_GRAIN_BANDS luma bins
 *                   with a per-bin pixel count -> per-band grain stddev
 *   4. AR proxy:    accumulate the lag-1 product resid*resid_right per band
 *                   and gate (a coarse spatial-correlation scalar -> AR seed)
 * The reduction is sliced (PEL_GRAIN_SLICES) to cut atomic contention; the host
 * sums the slices and fits the AV1 piecewise scaling function + AR seed.
 *
 * This standalone form runs against an r16ui storage image (16-bit internal
 * domain, normalized to [0,1] inside; the implied max is 65535). The in-tree
 * shipped shader (ffmpeg-patches/files/vulkan/pelorus_grain_estimate.comp.glsl)
 * runs the algorithm against a normalized-float image array and applies its
 * descriptor-derived sample scale before arithmetic. This standalone shader
 * exercises the same estimator shape, not FFmpeg's storage conversion.
 */
#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0, r16ui) uniform readonly uimage2D srcImg;

#define PEL_GRAIN_BANDS  8
#define PEL_GRAIN_SLICES 32
#define PEL_GRAIN_GATES  3

/* Signed lag-1 products are bias-encoded into uint atomics: each add stores
 * (prod + CORR_BIAS) so the unsigned accumulator never underflows; the host
 * subtracts corr_cnt*CORR_BIAS. Residuals are clamped to
 * [-RES_CLAMP, RES_CLAMP] = [-0.08, 0.08], so prod is in
 * [-RES_CLAMP^2, RES_CLAMP^2] -> CORR_BIAS = RES_CLAMP^2 = 0.0064.
 *
 * The clamp is lossless for real grain (sensor/film grain stddev is well under
 * 0.08 of full scale; it only caps edge-leakage outliers the edge gate mostly
 * removes already). Every per-pixel add is then at most 1921 fixed-point units
 * at SUMSQ_GS=3e5 / CORR_GS=1.5e5, which times the largest per-slice pixel
 * count (1105920 at DCI 8K) stays under 2^32. Each add is rounded to the
 * nearest unit; truncation would bias every add by half a unit and swamp the
 * small lag-1 products of real grain (ADR-0161). */
/* The gated members hold one [BANDS * SLICES] block per gate, gate 0 first. */
layout(binding = 1, std430) buffer GrainBuf {
    uint sumsq[PEL_GRAIN_GATES * PEL_GRAIN_BANDS * PEL_GRAIN_SLICES];    /* Σ resid^2 * SUMSQ_GS */
    uint cnt[PEL_GRAIN_GATES * PEL_GRAIN_BANDS * PEL_GRAIN_SLICES];      /* gated-pixel count    */
    uint corr[PEL_GRAIN_GATES * PEL_GRAIN_BANDS * PEL_GRAIN_SLICES];     /* Σ (prod + BIAS) * CORR_GS */
    uint corr_cnt[PEL_GRAIN_GATES * PEL_GRAIN_BANDS * PEL_GRAIN_SLICES]; /* lag-1 sample count   */
    uint total[PEL_GRAIN_BANDS * PEL_GRAIN_SLICES];                      /* every band pixel     */
};

layout(push_constant, std430) uniform Params {
    int   width;       /*  0  plane width                                       */
    int   height;      /*  4  plane height                                      */
    float edge_thr;     /*  8  3x3 range above which a pixel is an edge (skipped)*/
} pc;

const float SUMSQ_GS = 300000.0; /* resid^2 fixed point (overflow-safe to 8K)  */
const float CORR_GS = 150000.0;  /* lag-1 product fixed point (overflow-safe)  */
const float CORR_BIAS = 0.0064;  /* lag-1 product bias = RES_CLAMP^2           */
const float RES_CLAMP = 0.08;    /* residual clamp (lossless for real grain)   */
/* gate g = GATE_STEP[g] * edge_thr (ADR-0230) */
const float GATE_STEP[3] = float[3](1.0, 2.0, 4.0);

float load_norm(int x, int y) {
    x = clamp(x, 0, pc.width - 1);
    y = clamp(y, 0, pc.height - 1);
    return float(imageLoad(srcImg, ivec2(x, y)).r) / 65535.0;
}

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    if (x >= pc.width || y >= pc.height)
        return;

    float c = load_norm(x, y);

    /* 3x3 box mean + min/max for the edge gate. */
    float mean = 0.0, lo = 1.0, hi = 0.0;
    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            float v = load_norm(x + dx, y + dy);
            mean += v;
            lo = min(lo, v);
            hi = max(hi, v);
        }
    }
    mean /= 9.0;

    /* Intensity band from the local mean (grain strength is intensity-dependent
     * — the AV1/H.274 scaling function models exactly this). */
    int band = clamp(int(mean * float(PEL_GRAIN_BANDS)), 0, PEL_GRAIN_BANDS - 1);

    uint slice = (uint(y) * uint(pc.width) + uint(x)) % uint(PEL_GRAIN_SLICES);
    uint bidx = uint(band) * uint(PEL_GRAIN_SLICES) + slice;

    /* Band total and gate chain: the host tells heavy grain, which the default
     * gate truncates, from texture (ADR-0229, ADR-0230). Edge gate: a large
     * neighbourhood range is structure, not grain. The gates nest. */
    atomicAdd(total[bidx], 1u);
    float range = hi - lo;
    if (range > GATE_STEP[PEL_GRAIN_GATES - 1] * pc.edge_thr)
        return;

    float resid = clamp(c - mean, -RES_CLAMP, RES_CLAMP);
    for (int g = 0; g < PEL_GRAIN_GATES; g++) {
        if (range <= GATE_STEP[g] * pc.edge_thr) {
            uint gidx = uint(g * PEL_GRAIN_BANDS * PEL_GRAIN_SLICES) + bidx;
            atomicAdd(sumsq[gidx], uint(resid * resid * SUMSQ_GS + 0.5));
            atomicAdd(cnt[gidx], 1u);
        }
    }

    /* lag-1 spatial correlation (AR proxy), banded by this pixel: a pair
     * counts at a gate only when the right neighbour is within it too, so the
     * product reflects grain, not an edge transition. */
    float cr = load_norm(x + 1, y);
    float meanR = 0.0, loR = 1.0, hiR = 0.0;
    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            float v = load_norm(x + 1 + dx, y + dy);
            meanR += v;
            loR = min(loR, v);
            hiR = max(hiR, v);
        }
    }
    meanR /= 9.0;
    float pair = max(range, hiR - loR);
    float residR = clamp(cr - meanR, -RES_CLAMP, RES_CLAMP);
    float prod = resid * residR;
    for (int g = 0; g < PEL_GRAIN_GATES; g++) {
        if (pair <= GATE_STEP[g] * pc.edge_thr) {
            uint gidx = uint(g * PEL_GRAIN_BANDS * PEL_GRAIN_SLICES) + bidx;
            atomicAdd(corr[gidx], uint(max(prod + CORR_BIAS, 0.0) * CORR_GS + 0.5));
            atomicAdd(corr_cnt[gidx], 1u);
        }
    }
}
