/*
 * pelorus_denoise.comp — temporal denoise compute shader (standalone reference).
 *
 * Copyright 2026 Lusoris. BSD+Patent (see libpelorus/include/pelorus/pelorus.h).
 *
 * Edge-preserving spatio-temporal denoiser (PEL_DENOISER_BILATERAL_TEMPORAL).
 * Single compute pass over a CAUSAL window: image 0 is the current frame, images
 * 1..actualPrev are previous frames (same coordinate; no motion compensation).
 *
 *   filtered = num / den,  with
 *     num = (1-blend)*num_spatial + blend*num_temporal
 *     den = (1-blend)*den_spatial + blend*den_temporal
 *   out = mix(cur, filtered, strength)
 *
 * Spatial term: an NLM-lite joint bilateral over a (2*patch+1)^2 window of the
 * current frame. The range weight is a 3x3-patch SSD — a real edge has high
 * patch SSD across it, so its weight collapses and the filter refuses to average
 * across the edge (preserves text / facial lines), while flat-region noise (low
 * patch SSD) is averaged away. The centre carries a self-weight of 1, so den>0.
 *
 * Temporal term: the same-coordinate sample of each previous frame, gated by a
 * per-pixel similarity threshold (a delta above tcut breaks the walk so motion /
 * scene-cuts cannot ghost) and decayed by tdecay per frame. With forward
 * lookahead (ADR-0137, pc.actualNext > 0) the walk is bidirectional: one
 * same-coordinate sample of the NEXT frame is added, tcut-gated like the prev
 * taps, recovering the leading frame of a held animation drawing.
 *
 * This standalone form runs one dispatch per plane against r16ui storage images
 * (16-bit internal domain, normalized to [0,1] inside). It never synthesises the
 * stored texel — it loads, overwrites the computed component and stores the whole
 * vector — which is the contract the in-tree filter needs to keep the second
 * component of a semi-planar chroma plane (V on NV12/P010/NV16/NV24/P016) alive.
 * The in-tree FFmpeg filter ships its own shader at
 * ffmpeg-patches/files/vulkan/pelorus_denoise.comp.glsl,
 * compiled to SPIR-V at build time (ADR-0143). That file -- not this one -- is what
 * FFmpeg executes. This reference is a standalone r16ui variant kept for the fast
 * gate and for reading the algorithm without FFmpeg's plumbing; it is NOT a second
 * implementation to hand-synchronise.
 */
#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

/* image 0 = current frame; 1..PEL_DENOISE_MAX_PREV = previous frames. */
layout(binding = 0, r16ui) uniform readonly  uimage2D srcImg[5];
layout(binding = 1, r16ui) uniform writeonly uimage2D dstImg;
/* Motion-compensated taps (ADR-0113): per-cell quarter-pel MV + confidence,
 * uploaded by the host from PEL_SEC_MOTION / PEL_SEC_MOTION_CONF. */
layout(binding = 2, std430) readonly buffer MvGrid { uint mv_packed[]; };
layout(binding = 3, std430) readonly buffer ConfGrid { uint conf_packed[]; };
/* Forward-lookahead tap (ADR-0137): the NEXT frame. Same-coordinate, tcut-gated
 * like the prev taps; gated by pc.actualNext (0 => causal, the tap never fires).
 * Mirrors the in-tree filter's next0_images binding. */
layout(binding = 4, r16ui) uniform readonly uimage2D nextImg;

layout(push_constant, std430) uniform Params {
    int   width;        //  0  plane width
    int   height;       //  4  plane height
    int   plane;        //  8  0=Y 1=Cb 2=Cr 3=A (selects sigma/strength on host)
    int   actualPrev;   // 12  valid previous frames this dispatch (0..MAX_PREV)

    float sigmaS;       // 16  spatial range sigma for THIS plane (normalized)
    float sigmaT;       // 20  temporal gate bandwidth (normalized)
    float strength;     // 24  dry/wet mix for THIS plane (0..1)
    float blend;        // 28  spatial<->temporal blend (0=spatial 1=temporal)

    int   patchR;       // 32  spatial window radius (0 = temporal-only)
    float tdecay;       // 36  per-frame temporal trust falloff
    float tcut;         // 40  per-pixel scene-cut/fast-motion clamp (normalized)
    int   flags;        // 44  bit0=temporal bit1=motionComp bit2=protectDetail
    int   grid_cols;    // 48  MV/conf grid cols (0 => no MC this dispatch)
    int   grid_rows;    // 52
    int   cell_w;       // 56  cell size in THIS plane's pixels
    int   cell_h;       // 60
    float mv_scale;     // 64  stored MV -> THIS plane's px (the host bakes
                        //     quarter-pel * per-plane chroma subsampling here,
                        //     so this single-plane .comp needs no chroma branch —
                        //     the filter applies chroma_shift in-shader instead)
    int   actualNext;   // 68  forward-lookahead taps this dispatch (0 or 1)
} pc;

const int FLAG_TEMPORAL = 1;
const int FLAG_MOTION_COMP = 2;
const int FLAG_PROTECT_DETAIL = 4;
const float EPS = 1e-6;
/* exp(x) == exp2(x * LOG2E); folded into the loop-invariant weight factors. */
const float LOG2E = 1.4426950408889634;

/* Pinned linear interpolation, the shipped filter's mix() replacement (its
 * tile=0/tile=1 bit-identity needs every output-path operation `precise`, and
 * glslang never decorates the mix()/smoothstep() extended instructions). */
float pel_lerp(float a, float b, float t) {
    precise float r = a + t * (b - a);
    return r;
}

float fetchN(int img, int px, int py) {
    px = clamp(px, 0, pc.width  - 1);
    py = clamp(py, 0, pc.height - 1);
    return float(imageLoad(srcImg[img], ivec2(px, py)).r) / 65535.0;
}

/* Forward-lookahead fetch (ADR-0137): same-coordinate read of the NEXT frame. */
float fetchNext(int px, int py) {
    px = clamp(px, 0, pc.width  - 1);
    py = clamp(py, 0, pc.height - 1);
    return float(imageLoad(nextImg, ivec2(px, py)).r) / 65535.0;
}

/* --- motion-compensated previous-frame fetch (ADR-0113). This standalone
 * reference reads the MV in THIS plane's pixels (the host bakes quarter-pel *
 * chroma subsampling into pc.mv_scale and pc.cell_w/h), so there is no
 * in-shader chroma branch here. */
int pel_se16(uint v) { return int(v << 16) >> 16; } // sign-extend low 16 bits
ivec2 pel_cell(ivec2 p) {
    return clamp(p / ivec2(pc.cell_w, pc.cell_h), ivec2(0),
                 ivec2(pc.grid_cols - 1, pc.grid_rows - 1));
}
vec2 pel_mc_mv(ivec2 p) {                        // MV in THIS plane's pixels
    ivec2 cell = pel_cell(p);
    uint packed = mv_packed[cell.y * pc.grid_cols + cell.x];
    return vec2(pel_se16(packed & 0xFFFFu), pel_se16(packed >> 16)) * pc.mv_scale;
}
float pel_mc_conf(ivec2 p) {                     // confidence in [0,1]
    ivec2 cell = pel_cell(p);
    precise float c = float(conf_packed[cell.y * pc.grid_cols + cell.x] & 0xFFu) *
                      (1.0 / 255.0);
    return c;
}
float pel_prev_mc(int t, ivec2 pos) {
    precise vec2 sp = vec2(pos) + pel_mc_mv(pos); // sub-pel sample point
    ivec2 ip = ivec2(floor(sp));
    precise vec2 f = sp - vec2(ip);
    float p00 = fetchN(t, ip.x,     ip.y);
    float p10 = fetchN(t, ip.x + 1, ip.y);
    float p01 = fetchN(t, ip.x,     ip.y + 1);
    float p11 = fetchN(t, ip.x + 1, ip.y + 1);
    return pel_lerp(pel_lerp(p00, p10, f.x), pel_lerp(p01, p11, f.x), f.y);
}

/* Shared-memory tiling of the current-frame spatial window. The NLM range term
 * re-reads an overlapping (2*patchR+3)^2 window ~9x per pixel (fetch-bound, not
 * ALU-bound), so the workgroup loads it once into s_tile and every spatial read
 * hits shared memory. PEL_HALO = max patchR (3) + the 1-px patch ring. This
 * reference models — and CI compile-checks — the shipped filter's opt-in tile=1
 * path (ADR-0134, a large win on bandwidth-limited GPUs, ~neutral on cache-rich
 * ones); with the default tile=0 the filter reads the image directly. Both are
 * bit-identical. The canonical shipped shader lives under
 * ffmpeg-patches/files/vulkan/ (ADR-0143). */
#define PEL_HALO 4
#define PEL_TILE 24  // 16 (workgroup dim) + 2 * PEL_HALO
shared float s_tile[PEL_TILE * PEL_TILE];
void pel_load_tile() {
    ivec2 wgsz = ivec2(gl_WorkGroupSize.xy);
    ivec2 base = ivec2(gl_WorkGroupID.xy) * wgsz - PEL_HALO;
    uint n = uint(PEL_TILE * PEL_TILE);
    uint stride = gl_WorkGroupSize.x * gl_WorkGroupSize.y;
    barrier();
    for (uint k = gl_LocalInvocationIndex; k < n; k += stride) {
        ivec2 t = ivec2(int(k) - (int(k) / PEL_TILE) * PEL_TILE, int(k) / PEL_TILE);
        s_tile[k] = fetchN(0, base.x + t.x, base.y + t.y);
    }
    barrier();
}
float tcur(ivec2 off) {
    ivec2 lc = ivec2(gl_LocalInvocationID.xy) + PEL_HALO + off;
    return s_tile[lc.y * PEL_TILE + lc.x];
}

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    int x = gid.x, y = gid.y;
    /* uniform: every invocation loads + barriers before the bounds-cull return */
    pel_load_tile();
    if (x >= pc.width || y >= pc.height)
        return;

    /* Same expression order as the shipped filter: every output-path value is
     * `precise`, no division sits inside a loop (kr/kd/kt are the folded
     * loop-invariant weight factors), and fma() marks the fused accumulations
     * (BUG-027; see ffmpeg-patches/files/vulkan/pelorus_denoise.comp.glsl). */
    precise float C = tcur(ivec2(0, 0));

    // --- spatial NLM-lite joint bilateral over the current frame ---
    precise float numS = C;                // centre self-weight
    precise float denS = 1.0;
    if (pc.patchR > 0) {
        // wr = exp(-(ssd / 9) / hs2), wd = exp(-r^2 / (2 * sd2))
        precise float hs2 = pc.sigmaS * pc.sigmaS + EPS;     // range bandwidth^2
        precise float sd2 = float(pc.patchR * pc.patchR) + EPS; // domain sigma^2
        precise float kr = -LOG2E / (9.0 * hs2);
        precise float kd = -LOG2E / (2.0 * sd2);
        for (int dy = -pc.patchR; dy <= pc.patchR; dy++) {
            for (int dx = -pc.patchR; dx <= pc.patchR; dx++) {
                if (dx == 0 && dy == 0)
                    continue;
                // 3x3-patch SSD between the centre patch and the neighbour patch
                precise float ssd = 0.0;
                for (int ky = -1; ky <= 1; ky++) {
                    for (int kx = -1; kx <= 1; kx++) {
                        precise float d = tcur(ivec2(kx, ky)) -
                                          tcur(ivec2(dx + kx, dy + ky));
                        ssd = fma(d, d, ssd);
                    }
                }
                precise float w = exp2(ssd * kr) *
                                  exp2(float(dx * dx + dy * dy) * kd);
                numS = fma(w, tcur(ivec2(dx, dy)), numS);
                denS += w;
            }
        }
    }

    // --- temporal gated averaging over previous frames (same coordinate) ---
    precise float numT = C;                // centre self-weight
    precise float denT = 1.0;
    if ((pc.flags & FLAG_TEMPORAL) != 0) {
        // w = exp(-delta^2 / ht2) * decay, the divisor folded once into kt
        precise float kt = -LOG2E / (pc.sigmaT * pc.sigmaT + EPS);
        precise float decay = 1.0;
        precise float conf = 0.0;
        bool mc = (pc.flags & FLAG_MOTION_COMP) != 0 && pc.grid_cols != 0;
        if (mc)
            conf = pel_mc_conf(ivec2(x, y));
        for (int t = 1; t <= pc.actualPrev; t++) {
            precise float p = fetchN(t, x, y);
            if (mc) {
                // blend same-coord <-> motion-warped by per-block confidence;
                // low conf (noise-matched MV) falls back toward same-coord, and
                // the tcut gate below still rejects bad/occluded taps either way.
                p = pel_lerp(p, pel_prev_mc(t, ivec2(x, y)), conf);
            }
            precise float delta = abs(C - p);
            if (delta > pc.tcut)
                break;                     // anti-ghost: stop at motion / scene-cut
            decay *= pc.tdecay;
            precise float w = exp2(delta * delta * kt) * decay;
            numT = fma(w, p, numT);
            denT += w;
        }
        // --- forward-lookahead tap (ADR-0137): one same-coord NEXT-frame sample,
        // tcut-gated like the prev taps. Recovers the leading frame of a held
        // animation drawing (the trailing frame already gets the causal prev). ---
        if (pc.actualNext > 0) {
            precise float p = fetchNext(x, y);
            precise float delta = abs(C - p);
            if (delta <= pc.tcut) {
                precise float w = exp2(delta * delta * kt) * pc.tdecay;
                numT = fma(w, p, numT);
                denT += w;
            }
        }
    }

    // --- combine, then dry/wet ---
    precise float num = (1.0 - pc.blend) * numS + pc.blend * numT;
    precise float den = (1.0 - pc.blend) * denS + pc.blend * denT;
    precise float filtered = num / max(den, EPS);

    precise float strength = pc.strength;
    if ((pc.flags & FLAG_PROTECT_DETAIL) != 0 && pc.patchR > 0) {
        // damp strength where the spatial neighbourhood is textured (high local
        // stddev) so structure is not over-smoothed; sigmaS sets the knee.
        precise float mean = 0.0;
        for (int dy = -1; dy <= 1; dy++)
            for (int dx = -1; dx <= 1; dx++)
                mean += tcur(ivec2(dx, dy));
        mean *= (1.0 / 9.0);
        precise float var = 0.0;
        for (int dy = -1; dy <= 1; dy++) {
            for (int dx = -1; dx <= 1; dx++) {
                precise float d = tcur(ivec2(dx, dy)) - mean;
                var = fma(d, d, var);
            }
        }
        precise float activity = sqrt(var * (1.0 / 9.0));
        // smoothstep(sigmaS, 3 * sigmaS + EPS, activity), spelled out
        precise float e =
            clamp((activity - pc.sigmaS) / (2.0 * pc.sigmaS + EPS), 0.0, 1.0);
        precise float protect = e * e * (3.0 - 2.0 * e);
        strength *= (1.0 - protect);
    }

    precise float outv = pel_lerp(C, filtered, clamp(strength, 0.0, 1.0));
    int o = clamp(int(round(outv * 65535.0)), 0, 65535);
    /* Never synthesise the stored texel: load it, overwrite ONLY the component
     * this dispatch computed, store the whole vector. Here the images are
     * single-component r16ui so only .x carries picture data — but the pattern
     * is the contract, and the in-tree filter (which binds the real hwframe
     * plane images) depends on it: on a SEMI-PLANAR format (NV12/P010/NV16/
     * NV24/P016) the chroma plane is a TWO-component image with U in .x and V
     * in .y, so a synthesised uvec4(v, 0, 0, 0) writes a constant 0 into V and
     * annihilates the whole Cr channel. The filter additionally loops over both
     * components of such a plane in one dispatch, both times with the CHROMA
     * sigma/strength (the per-plane lanes at index 1 — those vec4 lanes are
     * indexed by PLANE, not by component). This standalone reference is
     * dispatched per plane against single-component images, so pc.plane alone
     * selects its parameters. */
    uvec4 texel = imageLoad(srcImg[0], ivec2(x, y));
    texel.x = uint(o);
    imageStore(dstImg, ivec2(x, y), texel);
}
