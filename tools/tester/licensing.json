{
  "schema_version": 1,
  "comment": "Licence record of the Pelorus tester image (ADR-0178, #236), read by licensing.py. Every file in the image belongs to one component below (first match in list order), to a Debian package (dpkg ownership; its copyright file is required), or to an ignore rule that names a reason and an expiry date. A new package, library, licence or file fails the image build until it is recorded here. Edit this file together with the Containerfile; `licensing.py record` checks it without an image.",
  "repository": "https://github.com/VMAFx/pelorus",
  "notices_path": "usr/share/licenses/pelorus-tester/THIRD_PARTY_NOTICES.txt",
  "licences": {
    "EUPL-1.2": {
      "redistributable": true,
      "text": "usr/share/licenses/pelorus-tester/texts/EUPL-1.2.txt"
    },
    "LGPL-2.1-or-later": {
      "redistributable": true,
      "text": "usr/share/licenses/pelorus-tester/texts/LGPL-2.1-or-later.txt"
    },
    "GPL-3.0-or-later": {
      "redistributable": true,
      "text": "usr/share/licenses/pelorus-ffmpeg/COPYING.GPLv3"
    },
    "MIT": {
      "redistributable": true,
      "text": "usr/share/licenses/pelorus-tester/texts/MIT.txt"
    },
    "Apache-2.0": {
      "redistributable": true,
      "text": "usr/share/common-licenses/Apache-2.0"
    },
    "MPL-2.0": {
      "redistributable": true,
      "text": "usr/share/common-licenses/MPL-2.0"
    },
    "GPL-2.0-or-later": {
      "redistributable": true,
      "text": "usr/share/common-licenses/GPL-2"
    },
    "Python-2.0": {
      "redistributable": true,
      "text": null
    },
    "CC-BY-3.0": {
      "redistributable": true,
      "text": "usr/share/common-licenses/CC-BY-3.0",
      "attribution_required": true
    },
    "LicenseRef-licence-text": {
      "redistributable": true,
      "text": null
    },
    "LicenseRef-nonfree": {
      "redistributable": false,
      "text": null
    },
    "LicenseRef-NVIDIA-CUDA-EULA": {
      "redistributable": false,
      "text": null
    }
  },
  "debian": {
    "components": [
      "main"
    ],
    "sources_file": "etc/apt/sources.list.d/debian.sources"
  },
  "ignore": [
    {
      "paths": [
        ".dockerenv",
        "etc/hosts",
        "etc/hostname",
        "etc/resolv.conf"
      ],
      "why": "files the container runtime mounts or creates, never part of an image layer",
      "expires": "2027-04-09"
    },
    {
      "paths": [
        "var/lib/dpkg/**",
        "var/lib/apt/**",
        "var/cache/**",
        "var/log/**",
        "var/lib/pam/**",
        "var/lib/python/**",
        "var/lib/shells.state",
        "var/lib/systemd/**",
        "var/spool/**"
      ],
      "why": "package manager and maintainer-script state; the packages it describes are checked by dpkg ownership",
      "expires": "2027-04-09"
    },
    {
      "paths": [
        "etc/.pwd.lock",
        "etc/ca-certificates.conf",
        "etc/environment",
        "etc/fstab",
        "etc/group",
        "etc/group-",
        "etc/gshadow",
        "etc/ld.so.cache",
        "etc/localtime",
        "etc/motd",
        "etc/mtab",
        "etc/nsswitch.conf",
        "etc/passwd",
        "etc/passwd-",
        "etc/profile",
        "etc/shadow",
        "etc/shells",
        "etc/subgid",
        "etc/subuid",
        "etc/security/opasswd",
        "root/.bashrc",
        "root/.profile",
        "usr/local/man",
        "etc/inputrc",
        "etc/networks",
        "etc/python3/debian_config"
      ],
      "why": "configuration written by the Debian base image build and its maintainer scripts; no licensable content of its own",
      "expires": "2027-04-09"
    },
    {
      "paths": [
        "etc/apt/**",
        "etc/dpkg/**",
        "etc/pam.d/**",
        "etc/systemd/system/**"
      ],
      "why": "configuration of Debian packages (apt, dpkg, pam, systemd units); the scripts are covered by their packages' copyright files",
      "expires": "2027-04-09"
    },
    {
      "paths": [
        "etc/alternatives/**",
        "usr/bin/awk",
        "usr/bin/nawk",
        "usr/bin/pager",
        "usr/bin/which",
        "usr/sbin/rmt",
        "usr/sbin/policy-rc.d"
      ],
      "why": "symlinks and policy script written by update-alternatives and package scripts",
      "expires": "2027-04-09"
    },
    {
      "paths": [
        "etc/ssl/certs/**"
      ],
      "why": "hash and bundle links generated by update-ca-certificates from the ca-certificates package",
      "expires": "2027-04-09"
    },
    {
      "paths": [
        "usr/lib/python3*/**/__pycache__/**",
        "usr/share/python3/**/__pycache__/**"
      ],
      "why": "bytecode compiled from the Debian python3 packages at install",
      "expires": "2027-04-09"
    }
  ],
  "components": [
    {
      "id": "ffmpeg",
      "name": "FFmpeg with the Pelorus patch stack",
      "version": "n9.0.2",
      "version_from": "build-config.env:FFMPEG_TAG",
      "spdx": "GPL-3.0-or-later",
      "paths": [
        "opt/ffmpeg/bin/ffmpeg",
        "opt/ffmpeg/bin/ffprobe",
        "opt/ffmpeg/lib/lib*.a",
        "opt/ffmpeg/lib/pkgconfig/*.pc",
        "opt/ffmpeg/include/**",
        "opt/ffmpeg/share/ffmpeg/**",
        "usr/share/licenses/pelorus-ffmpeg/COPYING.GPLv3"
      ],
      "source": "https://github.com/FFmpeg/FFmpeg",
      "notes": [
        "Built with --enable-gpl --enable-version3, never nonfree (tools/tester/check-ffmpeg-licence.sh). FFmpeg's own sources are LGPL-2.1-or-later and GPL parts are enabled; the combined binary is GPL-3.0-or-later.",
        "The exact FFmpeg commit and the Pelorus commit are named at the top of this file; the companion -source image holds the tree as compiled."
      ],
      "redistributable": true
    },
    {
      "id": "pelorus-ffmpeg-patches",
      "name": "Pelorus filters, bitstream filter and shaders compiled into FFmpeg",
      "version": "@commit",
      "spdx": "LGPL-2.1-or-later",
      "kind": "embedded",
      "embedded_in": "ffmpeg",
      "source": "https://github.com/VMAFx/pelorus/tree/master/ffmpeg-patches",
      "notes": [
        "Files under ffmpeg-patches/ keep FFmpeg's LGPL-2.1-or-later (ADR-0171). They are compiled into the ffmpeg binary, which is distributed under GPL-3.0-or-later."
      ],
      "redistributable": true
    },
    {
      "id": "libpelorus",
      "name": "libpelorus",
      "version": "@commit",
      "spdx": "EUPL-1.2",
      "paths": [
        "opt/pelorus/lib/libpelorus.so*",
        "opt/pelorus/lib/pkgconfig/libpelorus.pc",
        "opt/pelorus/include/pelorus/*.h"
      ],
      "source": "https://github.com/VMAFx/pelorus",
      "notes": [
        "ffmpeg links libpelorus. EUPL-1.2 Appendix lists GPL-3.0 as a compatible licence for the combined work."
      ],
      "redistributable": true
    },
    {
      "id": "tester-fixtures",
      "name": "Tester fixtures",
      "version": "lock 1",
      "spdx": "EUPL-1.2 AND CC-BY-3.0",
      "kind": "lock",
      "paths": [
        "opt/pelorus/tester/fixtures.lock.json"
      ],
      "lock": "opt/pelorus/tester/fixtures.lock.json",
      "source": "https://github.com/VMAFx/pelorus/blob/master/tools/tester/fixtures.lock.json",
      "notes": [
        "The fixtures are not baked into the image; the lock pins their bytes and records their licences, and the report program fetches them once. Each licence is recorded in the lock and listed below."
      ],
      "redistributable": true
    },
    {
      "id": "pelorus-tester",
      "name": "Pelorus tester program, schema and gates",
      "version": "@commit",
      "spdx": "EUPL-1.2",
      "paths": [
        "opt/pelorus/tester/*.py",
        "opt/pelorus/tester/*.sh",
        "opt/pelorus/tester/report.schema.json",
        "opt/pelorus/tester/licensing.json",
        "opt/pelorus/tester/Containerfile",
        "opt/pelorus/tester/Containerfile.dockerignore",
        "opt/pelorus/tester/tool-hashes.json"
      ],
      "spdx_headers": [
        ".py",
        ".sh"
      ],
      "source": "https://github.com/VMAFx/pelorus/tree/master/tools/tester",
      "redistributable": true
    },
    {
      "id": "licence-texts",
      "name": "Licence texts shipped with the image",
      "version": "@commit",
      "spdx": "LicenseRef-licence-text",
      "paths": [
        "usr/share/licenses/pelorus-tester/texts/**"
      ],
      "source": "https://github.com/VMAFx/pelorus/tree/master/LICENSES",
      "notes": [
        "Verbatim texts from the repository's LICENSES/ directory."
      ],
      "redistributable": true
    },
    {
      "id": "notices",
      "name": "This notices file",
      "version": "@commit",
      "spdx": "EUPL-1.2",
      "paths": [
        "usr/share/licenses/pelorus-tester/THIRD_PARTY_NOTICES.txt"
      ],
      "source": "https://github.com/VMAFx/pelorus/blob/master/tools/tester/licensing.py",
      "notes": [
        "Generated by tools/tester/licensing.py from tools/tester/licensing.json during the image build."
      ],
      "redistributable": true
    },
    {
      "id": "image-build-records",
      "name": "Debian source package list of the image",
      "version": "@commit",
      "spdx": "EUPL-1.2",
      "paths": [
        "installed-sources.txt"
      ],
      "source": "https://github.com/VMAFx/pelorus/blob/master/tools/tester/Containerfile",
      "notes": [
        "Names the Debian source packages and versions the image installed; the -source image holds them."
      ],
      "redistributable": true
    },
    {
      "id": "vulkan-loader-tools",
      "name": "Vulkan loader and tools (Debian libvulkan1, vulkan-tools)",
      "version": "Debian trixie",
      "spdx": "Apache-2.0 AND MIT",
      "kind": "dpkg",
      "packages": [
        "libvulkan1",
        "vulkan-tools"
      ],
      "source": "https://tracker.debian.org/pkg/vulkan-loader",
      "notes": [
        "Debian's copyright files are shipped under /usr/share/doc; the source is in the -source image."
      ],
      "redistributable": true
    },
    {
      "id": "tester-python",
      "name": "Python interpreter and standard library (Debian python3)",
      "version": "Debian trixie",
      "spdx": "Python-2.0",
      "kind": "dpkg",
      "packages": [
        "python3",
        "python3-minimal",
        "python3.13",
        "python3.13-minimal",
        "libpython3-stdlib",
        "libpython3.13-minimal",
        "libpython3.13-stdlib"
      ],
      "source": "https://tracker.debian.org/pkg/python3.13",
      "redistributable": true,
      "notes": [
        "The report program needs the standard library (shutil, tempfile, urllib), so the image installs python3, not python3-minimal."
      ]
    },
    {
      "id": "ca-certificates",
      "name": "CA certificate bundle (Debian ca-certificates)",
      "version": "Debian trixie",
      "spdx": "MPL-2.0 AND GPL-2.0-or-later",
      "kind": "dpkg",
      "packages": [
        "ca-certificates"
      ],
      "source": "https://tracker.debian.org/pkg/ca-certificates",
      "redistributable": true
    }
  ]
}
