# A) analyze on 8-bit semi-planar nv12 vs yuv420p (and multiplane on/off)
devopts='' yuv420p: lavfi.pelorus.variance=0.051847 lavfi.pelorus.edge=0.068983 
devopts='' nv12: lavfi.pelorus.variance=0.041644 lavfi.pelorus.edge=0.118623 
devopts='' yuv420p10le: lavfi.pelorus.variance=0.051548 lavfi.pelorus.edge=0.068783 
